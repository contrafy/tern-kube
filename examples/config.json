{
  "$schema": "https://raw.githubusercontent.com/contrafy/tern-kube/master/schema/config.schema.json",
  "schema_version": 1,
  "general": {
    "native_default": true,
    "max_rows": 20000,
    "max_rendered_rows": 500,
    "max_capture_bytes": 16777216,
    "shell_env": true,
    "streaming_view": "raw"
  },
  "aliases": {
    "additional": []
  },
  "explore": {
    "allow_live_queries": true,
    "auto_refresh": false,
    "query_timeout_ms": 10000,
    "relationship_max_nodes": 250,
    "logs_tail": 500
  },
  "mutations": {
    "enabled": true,
    "interactive_guard": false,
    "require_target_confirmation": true,
    "allow_failed_preview_override": false,
    "preview_timeout_ms": 30000,
    "execute_timeout_ms": 300000
  },
  "security": {
    "show_secret_values": false,
    "sensitive_output_strict_mode": false
  },
  "quick_actions": {
    "placement": "right",
    "shell_command": ["sh", "-c", "command -v bash >/dev/null 2>&1 && exec bash || exec sh"],
    "logs_tail": 200,
    "debug_image": "busybox:1.36"
  },
  "kubectl": "kubectl",
  "kubeconfig": null,
  "gitops": {
    "helm": [],
    "max_files": 2000,
    "max_bytes": 33554432,
    "max_file_bytes": 1048576,
    "render_kustomize": true,
    "gh": "gh"
  },
  "helm": {
    "program": "helm",
    "driver": "secret",
    "list_max": 1000,
    "history_max": 256,
    "auto_detect": true,
    "chart_sources": [],
    "rollback_wait": true,
    "rollback_wait_for_jobs": false,
    "rollback_cleanup_on_fail": false,
    "rollback_timeout_s": 240
  },
  "compare": {
    "contexts": [],
    "max_contexts": 8,
    "max_parallel": 4,
    "max_objects": 500
  }
}
