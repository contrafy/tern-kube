#!/bin/sh
# tern-kube-guard: approval gate for mutating kubectl commands in Tern.
#
#   tern-kube-guard kubectl [ARGS...]   run kubectl, asking Tern for approval
#                                       first when the verb mutates
#   tern-kube-guard status              print what the guard would do here
#
# Normally reached through the `kubectl` function that shell/tern-kube.zsh,
# shell/tern-kube.bash or shell/tern-kube.fish define. The request/response
# protocol is specified in shell/PROTOCOL.md; keep both in sync.

# BEGIN generated flags (scripts/guard/gen-flags from plugin/lib/kubectl/flags.luau, kubectl v1.34.1; do not edit)
tkg_g_lb='|disable-compression|help|insecure-skip-tls-verify|match-server-version|warnings-as-errors|'
tkg_g_lv='|as|as-group|as-uid|cache-dir|certificate-authority|client-certificate|client-key|cluster|context|kubeconfig|kuberc|log-flush-frequency|namespace|password|profile|profile-output|request-timeout|server|tls-server-name|token|user|username|v|vmodule|'
tkg_g_sb='|h|'
tkg_g_sv='|n|s|v|'
tkg_opt='|cascade|dry-run|validate|'
tkg_apply_lb='|all|allow-missing-template-keys|force|force-conflicts|openapi-patch|overwrite|prune|recursive|server-side|show-managed-fields|wait|'
tkg_apply_lv='|cascade|dry-run|field-manager|filename|grace-period|kustomize|output|prune-allowlist|selector|subresource|template|timeout|validate|'
tkg_apply_sb='|R|'
tkg_apply_sv='|f|k|l|o|'
tkg_delete_lb='|all|all-namespaces|force|ignore-not-found|interactive|now|recursive|wait|'
tkg_delete_lv='|cascade|dry-run|field-selector|filename|grace-period|kustomize|output|raw|selector|timeout|'
tkg_delete_sb='|A|R|i|'
tkg_delete_sv='|f|k|l|o|'
tkg_scale_lb='|all|allow-missing-template-keys|recursive|show-managed-fields|'
tkg_scale_lv='|current-replicas|dry-run|filename|kustomize|output|replicas|resource-version|selector|template|timeout|'
tkg_scale_sb='|R|'
tkg_scale_sv='|f|k|l|o|'
tkg_restart_lb='|allow-missing-template-keys|recursive|show-managed-fields|'
tkg_restart_lv='|field-manager|filename|kustomize|output|selector|template|'
tkg_restart_sb='|R|'
tkg_restart_sv='|f|k|l|o|'
tkg_undo_lb='|allow-missing-template-keys|recursive|show-managed-fields|'
tkg_undo_lv='|dry-run|filename|kustomize|output|selector|template|to-revision|'
tkg_undo_sb='|R|'
tkg_undo_sv='|f|k|l|o|'
tkg_pause_lb='|allow-missing-template-keys|recursive|show-managed-fields|'
tkg_pause_lv='|field-manager|filename|kustomize|output|selector|template|'
tkg_pause_sb='|R|'
tkg_pause_sv='|f|k|l|o|'
tkg_resume_lb='|allow-missing-template-keys|recursive|show-managed-fields|'
tkg_resume_lv='|field-manager|filename|kustomize|output|selector|template|'
tkg_resume_sb='|R|'
tkg_resume_sv='|f|k|l|o|'
tkg_patch_lb='|allow-missing-template-keys|local|recursive|show-managed-fields|'
tkg_patch_lv='|dry-run|field-manager|filename|kustomize|output|patch|patch-file|subresource|template|type|'
tkg_patch_sb='|R|'
tkg_patch_sv='|f|k|o|p|'
tkg_label_lb='|all|all-namespaces|allow-missing-template-keys|list|local|overwrite|recursive|show-managed-fields|'
tkg_label_lv='|dry-run|field-manager|field-selector|filename|kustomize|output|resource-version|selector|template|'
tkg_label_sb='|A|R|'
tkg_label_sv='|f|k|l|o|'
tkg_annotate_lb='|all|all-namespaces|allow-missing-template-keys|list|local|overwrite|recursive|show-managed-fields|'
tkg_annotate_lv='|dry-run|field-manager|field-selector|filename|kustomize|output|resource-version|selector|template|'
tkg_annotate_sb='|A|R|'
tkg_annotate_sv='|f|k|l|o|'
tkg_cordon_lb='|'
tkg_cordon_lv='|dry-run|selector|'
tkg_cordon_sb='|'
tkg_cordon_sv='|l|'
tkg_uncordon_lb='|'
tkg_uncordon_lv='|dry-run|selector|'
tkg_uncordon_sb='|'
tkg_uncordon_sv='|l|'
tkg_drain_lb='|delete-emptydir-data|disable-eviction|force|ignore-daemonsets|'
tkg_drain_lv='|chunk-size|dry-run|grace-period|pod-selector|selector|skip-wait-for-delete-timeout|timeout|'
tkg_drain_sb='|'
tkg_drain_sv='|l|'
tkg_edit_lb='|allow-missing-template-keys|output-patch|recursive|save-config|show-managed-fields|windows-line-endings|'
tkg_edit_lv='|field-manager|filename|kustomize|output|subresource|template|validate|'
tkg_edit_sb='|R|'
tkg_edit_sv='|f|k|o|'
# END generated flags

tkg_nl='
'

tkg_err() {
	printf 'tern-kube guard: %s\n' "$*" >&2
}

tkg_cleanup() {
	[ -n "${tkg_work-}" ] && rm -rf "$tkg_work"
	[ -n "${tkg_req-}" ] && rm -f "$tkg_req"
	[ -n "${tkg_resp-}" ] && rm -f "$tkg_resp"
	[ -n "${tkg_wrap_dir-}" ] && rm -rf "$tkg_wrap_dir"
	return 0
}

# Every refusal ends here: nothing has been executed, nothing will be.
tkg_refuse() {
	tkg_err "$@"
	tkg_err "$tkg_hint"
	tkg_cleanup
	exit 1
}

tkg_in() {
	case $1 in *"|$2|"*) return 0 ;; esac
	return 1
}

tkg_long_arity() {
	if tkg_in "$tkg_g_lb" "$1" || tkg_in "$tkg_v_lb" "$1"; then
		tkg_a=bool
	elif tkg_in "$tkg_g_lv" "$1"; then
		tkg_a=value
	elif tkg_in "$tkg_v_lv" "$1"; then
		if tkg_in "$tkg_opt" "$1"; then tkg_a=optional; else tkg_a=value; fi
	else
		tkg_a=unknown
	fi
}

tkg_short_arity() {
	if tkg_in "$tkg_g_sb" "$1" || tkg_in "$tkg_v_sb" "$1"; then
		tkg_a=bool
	elif tkg_in "$tkg_g_sv" "$1" || tkg_in "$tkg_v_sv" "$1"; then
		tkg_a=value
	else
		tkg_a=unknown
	fi
	case $1 in
	f) tkg_n=filename ;;
	k) tkg_n=kustomize ;;
	R) tkg_n=recursive ;;
	n) tkg_n=namespace ;;
	*) tkg_n=$1 ;;
	esac
}

# Tokenises args the way pflag does (flags anywhere, shorthand clusters, `--`
# ends flags) against the global set plus the current verb set, calling
# tkg_on_flag NAME VALUE, tkg_on_unknown RAW and tkg_on_pos WORD. A handler
# stops the walk by setting tkg_stop=1.
tkg_walk() {
	tkg_stop=0
	while [ $# -gt 0 ] && [ "$tkg_stop" = 0 ]; do
		tkg_t=$1
		shift
		case $tkg_t in
		--)
			while [ $# -gt 0 ] && [ "$tkg_stop" = 0 ]; do
				tkg_on_pos "$1"
				shift
			done
			;;
		--*=*)
			tkg_b=${tkg_t#--}
			tkg_long_arity "${tkg_b%%=*}"
			if [ "$tkg_a" = unknown ]; then
				tkg_on_unknown "$tkg_t"
			else
				tkg_on_flag "${tkg_b%%=*}" "${tkg_b#*=}"
			fi
			;;
		--?*)
			tkg_b=${tkg_t#--}
			tkg_long_arity "$tkg_b"
			case $tkg_a in
			bool) tkg_on_flag "$tkg_b" true ;;
			optional) tkg_on_flag "$tkg_b" "" ;;
			value)
				if [ $# -gt 0 ]; then
					tkg_on_flag "$tkg_b" "$1"
					shift
				else
					tkg_on_unknown "$tkg_t"
				fi
				;;
			*) tkg_on_unknown "$tkg_t" ;;
			esac
			;;
		-?*)
			tkg_r=${tkg_t#-}
			while [ -n "$tkg_r" ]; do
				tkg_c=${tkg_r%"${tkg_r#?}"}
				tkg_r=${tkg_r#?}
				tkg_short_arity "$tkg_c"
				if [ "$tkg_a" = unknown ]; then
					tkg_on_unknown "-$tkg_c"
					break
				fi
				case $tkg_r in
				=*)
					tkg_on_flag "$tkg_n" "${tkg_r#=}"
					break
					;;
				esac
				if [ "$tkg_a" = bool ]; then
					tkg_on_flag "$tkg_n" true
				elif [ -n "$tkg_r" ]; then
					tkg_on_flag "$tkg_n" "$tkg_r"
					break
				elif [ $# -gt 0 ]; then
					tkg_on_flag "$tkg_n" "$1"
					shift
				else
					tkg_on_unknown "-$tkg_c"
				fi
			done
			;;
		*) tkg_on_pos "$tkg_t" ;;
		esac
	done
}

# Phase 1: find the verb with the global flag set only (as cobra does while
# it searches for the subcommand).
tkg_on_flag() { :; }
tkg_on_unknown() {
	[ -z "$tkg_sub" ] && [ -z "$tkg_unknown" ] && tkg_unknown=$1
	return 0
}
tkg_on_pos() {
	if [ -z "$tkg_verb" ]; then
		tkg_verb=$1
		[ "$1" = rollout ] || tkg_stop=1
	else
		tkg_sub=$1
		tkg_stop=1
	fi
}

tkg_find_verb() {
	tkg_verb=
	tkg_sub=
	tkg_unknown=
	tkg_v_lb='|'
	tkg_v_lv='|'
	tkg_v_sb='|'
	tkg_v_sv='|'
	tkg_walk "$@"
	case $tkg_verb in
	apply | delete | scale | patch | label | annotate | cordon | uncordon | drain | edit) tkg_guarded=$tkg_verb ;;
	rollout)
		case $tkg_sub in
		restart | undo | pause | resume) tkg_guarded=$tkg_sub ;;
		esac
		;;
	esac
	[ -n "$tkg_guarded" ] || [ -z "$tkg_unknown" ] && return 0
	# An unknown flag before the verb may have swallowed it: fail closed when
	# a mutating verb could be the real one.
	for tkg_t in "$@"; do
		case $tkg_t in
		apply | delete | scale | rollout | patch | label | annotate | cordon | uncordon | drain | edit)
			tkg_err "cannot tell which kubectl command this is: unknown flag $tkg_unknown before the command name may take '$tkg_t' or another word as its value."
			tkg_refuse "move the flag after the command name (kubectl $tkg_t ... $tkg_unknown) and retry."
			;;
		esac
	done
	return 0
}

# Phase 2: the guarded verb is known; collect what the request needs.
# Input kinds: f (-f value), k (-k value), p (--patch-file value).
tkg_add_raw() {
	case $2 in
	*'
'*) tkg_refuse "a $(tkg_input_flag "$1") value contains a newline; the guard cannot fingerprint it." ;;
	esac
	tkg_raw="$tkg_raw$1 $2
"
}

tkg_input_flag() {
	case $1 in
	p) printf '%s' --patch-file ;;
	*) printf '%s' "-$1" ;;
	esac
}

tkg_true() {
	case $1 in
	true | 1 | t | T | TRUE | True) return 0 ;;
	esac
	return 1
}

tkg_on_flag2() {
	case $1 in
	context) tkg_flag_ctx=$2 ;;
	namespace) tkg_ns=$2 ;;
	kubeconfig) tkg_flag_kc=$2 ;;
	dry-run) tkg_dry=$2 ;;
	recursive) if tkg_true "$2"; then tkg_rec=1; else tkg_rec=; fi ;;
	local) if tkg_true "$2"; then tkg_local=1; else tkg_local=; fi ;;
	list) if tkg_true "$2"; then tkg_list=1; else tkg_list=; fi ;;
	filename)
		case $2 in
		*'"'*) tkg_refuse "-f values containing a double quote are not supported by the guard." ;;
		esac
		tkg_rest=$2,
		while [ -n "$tkg_rest" ]; do
			tkg_add_raw f "${tkg_rest%%,*}"
			tkg_rest=${tkg_rest#*,}
		done
		;;
	kustomize) tkg_add_raw k "$2" ;;
	patch-file) tkg_add_raw p "$2" ;;
	esac
}

tkg_scan_guarded() {
	eval "tkg_v_lb=\$tkg_${tkg_guarded}_lb tkg_v_lv=\$tkg_${tkg_guarded}_lv tkg_v_sb=\$tkg_${tkg_guarded}_sb tkg_v_sv=\$tkg_${tkg_guarded}_sv"
	tkg_flag_ctx=
	tkg_flag_kc=
	tkg_ns=
	tkg_ns_set=
	tkg_dry=none
	tkg_rec=
	tkg_local=
	tkg_list=
	tkg_raw=
	tkg_unknown2=
	tkg_on_flag() {
		[ "$1" = namespace ] && tkg_ns_set=1
		tkg_on_flag2 "$@"
	}
	tkg_on_unknown() { tkg_unknown2=$1; }
	tkg_on_pos() { :; }
	tkg_walk "$@"
}

# Commands that cannot change the cluster run without approval, unless a
# flag is unknown to the table (it could change what the command does).
tkg_passes_through() {
	[ -z "$tkg_unknown2" ] || return 1
	case $tkg_dry in
	client | server) return 0 ;;
	esac
	case $tkg_guarded in
	patch) [ -n "$tkg_local" ] ;;
	label | annotate) [ -n "$tkg_local" ] || [ -n "$tkg_list" ] ;;
	*) return 1 ;;
	esac
}

tkg_sha_tool() {
	if command -v sha256sum >/dev/null 2>&1; then
		tkg_sha=sha256sum
	elif command -v shasum >/dev/null 2>&1; then
		tkg_sha='shasum -a 256'
	else
		tkg_refuse "neither sha256sum nor shasum is available to fingerprint the request."
	fi
}

tkg_len() {
	tkg_l=$(printf '%s' "$1" | wc -c)
	tkg_l=$((tkg_l + 0))
}

tkg_canon_field() {
	tkg_len "$2"
	printf '%s %s:%s\n' "$1" "$tkg_l" "$2"
}

tkg_resolve_context() {
	if [ -n "$tkg_flag_ctx" ]; then
		tkg_ctx=$tkg_flag_ctx
		tkg_ctx_src=flag
		return 0
	fi
	if [ -n "$tkg_flag_kc" ]; then
		tkg_ctx=$(command kubectl --kubeconfig "$tkg_flag_kc" config current-context </dev/null) || tkg_ctx=
	else
		tkg_ctx=$(command kubectl config current-context </dev/null) || tkg_ctx=
	fi
	[ -n "$tkg_ctx" ] || tkg_refuse "could not resolve the current kubectl context ('kubectl config current-context' failed); pass --context explicitly."
	tkg_ctx_src=current-context
}

# Refuses input values that cannot be fingerprinted, before anything else.
tkg_check_value() {
	case $2 in
	-)
		if [ "$1" = p ]; then
			tkg_refuse "reading a patch from stdin (--patch-file -) cannot be previewed; save it to a file and pass --patch-file FILE."
		fi
		tkg_refuse "reading manifests from stdin (-f -) cannot be previewed; save them to a file and pass -f FILE."
		;;
	'') tkg_refuse "empty $(tkg_input_flag "$1") value." ;;
	http://* | https://*)
		if [ "$1" = p ]; then
			tkg_refuse "remote patch files ($2) cannot be fingerprinted; download it and pass --patch-file FILE."
		fi
		tkg_refuse "remote manifests ($2) cannot be fingerprinted; download them and pass -f FILE."
		;;
	esac
}

# Writes the sorted, de-duplicated absolute input paths to $tkg_work/paths.
tkg_list_inputs() {
	: >"$tkg_work/paths.raw"
	tkg_ifs=$IFS
	IFS='
'
	set -f
	for tkg_line in $tkg_raw; do
		IFS=$tkg_ifs
		set +f
		tkg_kind=${tkg_line%% *}
		tkg_p=${tkg_line#* }
		tkg_check_value "$tkg_kind" "$tkg_p"
		case $tkg_p in
		/*) ;;
		*) tkg_p=$tkg_cwd/$tkg_p ;;
		esac
		if [ "$tkg_kind" = p ]; then
			# kubectl reads exactly this path: never a directory walk.
			[ -e "$tkg_p" ] || tkg_refuse "no such file: $tkg_p"
			[ -f "$tkg_p" ] || tkg_refuse "$tkg_p is not a regular file (directories, stdin, devices and pipes cannot be previewed)."
			printf '%s\n' "$tkg_p" >>"$tkg_work/paths.raw"
		elif [ -d "$tkg_p" ]; then
			while :; do
				case $tkg_p in
				/) break ;;
				*/) tkg_p=${tkg_p%/} ;;
				*) break ;;
				esac
			done
			if [ -n "$(cd -- "$tkg_p" && find . -name '*
*' 2>/dev/null)" ]; then
				tkg_refuse "a file name under $tkg_p contains a newline; the guard cannot fingerprint it."
			fi
			if [ "$tkg_kind" = k ]; then
				(cd -- "$tkg_p" && find . ! -type d) >"$tkg_work/found" ||
					tkg_refuse "cannot list $tkg_p."
			elif [ -n "$tkg_rec" ]; then
				(cd -- "$tkg_p" && find . ! -type d \( -name '*.json' -o -name '*.yaml' -o -name '*.yml' \)) >"$tkg_work/found" ||
					tkg_refuse "cannot list $tkg_p."
			else
				(cd -- "$tkg_p" && find . -mindepth 1 -maxdepth 1 ! -type d \( -name '*.json' -o -name '*.yaml' -o -name '*.yml' \)) >"$tkg_work/found" ||
					tkg_refuse "cannot list $tkg_p."
			fi
			[ "$tkg_p" = / ] && tkg_p=
			while IFS= read -r tkg_f; do
				printf '%s/%s\n' "$tkg_p" "${tkg_f#./}"
			done <"$tkg_work/found" >>"$tkg_work/paths.raw"
		elif [ "$tkg_kind" = k ]; then
			tkg_refuse "-k needs a directory: $tkg_p"
		elif [ -e "$tkg_p" ]; then
			[ -f "$tkg_p" ] || tkg_refuse "$tkg_p is not a regular file (stdin, devices and pipes cannot be previewed)."
			printf '%s\n' "$tkg_p" >>"$tkg_work/paths.raw"
		else
			tkg_refuse "no such file or directory: $tkg_p"
		fi
		IFS='
'
		set -f
	done
	IFS=$tkg_ifs
	set +f
	LC_ALL=C sort -u "$tkg_work/paths.raw" >"$tkg_work/paths"
}

# Fresh fingerprint of the invocation: sets tkg_ctx, tkg_ctx_src, tkg_fp and
# writes "size sha256 path" lines to $tkg_work/files.
tkg_compute() {
	tkg_resolve_context
	tkg_cwd=$(pwd -P) || tkg_refuse "cannot determine the working directory."
	tkg_list_inputs
	: >"$tkg_work/files"
	while IFS= read -r tkg_f; do
		[ -f "$tkg_f" ] || tkg_refuse "$tkg_f is not a regular file (stdin, devices and pipes cannot be previewed)."
		tkg_size=$(wc -c <"$tkg_f") || tkg_refuse "cannot read $tkg_f."
		tkg_h=$($tkg_sha <"$tkg_f") || tkg_refuse "cannot hash $tkg_f."
		tkg_h=${tkg_h%%[!0-9a-f]*}
		[ ${#tkg_h} = 64 ] || tkg_refuse "unexpected digest for $tkg_f."
		printf '%s %s %s\n' "$((tkg_size + 0))" "$tkg_h" "$tkg_f" >>"$tkg_work/files"
	done <"$tkg_work/paths"
	{
		printf 'tern-kube/fp/v1\n'
		printf 'argv %s\n' "$#"
		for tkg_t in "$@"; do
			tkg_len "$tkg_t"
			printf '%s:%s\n' "$tkg_l" "$tkg_t"
		done
		tkg_canon_field context "$tkg_ctx"
		if [ -n "${KUBECONFIG-}" ]; then
			tkg_canon_field kubeconfig "$KUBECONFIG"
		else
			printf 'kubeconfig -\n'
		fi
		tkg_canon_field namespace "$tkg_ns"
		tkg_canon_field cwd "$tkg_cwd"
		printf 'files %s\n' "$(wc -l <"$tkg_work/files" | tr -d ' ')"
		while IFS= read -r tkg_line; do
			tkg_file_line
			tkg_len "$tkg_f"
			printf '%s:%s %s %s\n' "$tkg_l" "$tkg_f" "$tkg_size" "$tkg_h"
		done <"$tkg_work/files"
	} >"$tkg_work/canon"
	tkg_fp=$($tkg_sha <"$tkg_work/canon") || tkg_refuse "cannot hash the request."
	tkg_fp=${tkg_fp%%[!0-9a-f]*}
}

# Splits a "size sha256 path" line of $tkg_work/files (paths may hold spaces).
tkg_file_line() {
	tkg_size=${tkg_line%% *}
	tkg_f=${tkg_line#* }
	tkg_h=${tkg_f%% *}
	tkg_f=${tkg_f#* }
}

# JSON string literal of $1: escapes quote, backslash and control bytes;
# other bytes (UTF-8 included) pass through unchanged.
tkg_json() {
	tkg_fmt=$(printf '%s' "$1" | od -An -v -tu1 | awk '
		BEGIN { for (i = 0; i < 32; i++) esc[i] = sprintf("\\\\u%04x", i)
			esc[8] = "\\\\b"; esc[9] = "\\\\t"; esc[10] = "\\\\n"; esc[12] = "\\\\f"; esc[13] = "\\\\r" }
		{ for (i = 1; i <= NF; i++) {
			d = $i + 0
			if (d in esc) s = esc[d]
			else if (d == 34) s = "\\\\\""
			else if (d == 92) s = "\\\\\\\\"
			else if (d == 37) s = "%%"
			else s = sprintf("\\%03o", d)
			printf "%s", s
		} }')
	printf '"'
	# shellcheck disable=SC2059
	printf "$tkg_fmt"
	printf '"'
}

tkg_write_request() {
	{
		printf '{"version":1,"nonce":"%s","argv":[' "$tkg_nonce"
		tkg_sep=
		for tkg_t in "$@"; do
			printf '%s' "$tkg_sep"
			tkg_json "$tkg_t"
			tkg_sep=,
		done
		printf '],"program":'
		tkg_json "$tkg_program"
		printf ',"cwd":'
		tkg_json "$tkg_cwd"
		printf ',"kubeconfig":'
		if [ -n "${KUBECONFIG-}" ]; then tkg_json "$KUBECONFIG"; else printf null; fi
		printf ',"context":'
		tkg_json "$tkg_ctx"
		printf ',"context_source":"%s","namespace":' "$tkg_ctx_src"
		if [ -n "$tkg_ns_set" ]; then tkg_json "$tkg_ns"; else printf null; fi
		printf ',"pane":'
		tkg_json "$TERN_PANE"
		printf ',"files":['
		tkg_sep=
		while IFS= read -r tkg_line; do
			tkg_file_line
			printf '%s{"path":' "$tkg_sep"
			tkg_json "$tkg_f"
			printf ',"size":%s,"sha256":"%s"}' "$tkg_size" "$tkg_h"
			tkg_sep=,
		done <"$tkg_work/files"
		printf ']'
		if [ -n "${tkg_edit_file-}" ]; then
			printf ',"edit":{"file":'
			tkg_json "$tkg_edit_file"
			printf ',"original":'
			tkg_json "$tkg_edit_orig"
			printf '}'
		fi
		printf ',"fingerprint":"%s","created_at":%s,"timeout_s":%s}\n' "$tkg_fp" "$tkg_created" "$tkg_timeout"
	} >"$tkg_req"
}

tkg_mark_cancel() {
	(
		set -C
		printf 'cancelled_at=%s\n' "$(date +%s)" >"$tkg_spool/cancel-$tkg_nonce"
	) 2>/dev/null
	return 0
}

tkg_stop_waiting() {
	[ -n "${tkg_wpid-}" ] && kill -TERM "$tkg_wpid" 2>/dev/null
	[ -n "${tkg_tpid-}" ] && kill -TERM "$tkg_tpid" 2>/dev/null
	tkg_wpid=
	tkg_tpid=
	return 0
}

tkg_on_signal() {
	trap '' INT TERM HUP
	tkg_stop_waiting
	tkg_mark_cancel
	tkg_cleanup
	tkg_err "cancelled; $tkg_hint"
	exit "$tkg_sig_status"
}

# The tern binary: TERN_BIN, else TERN_EXE (set by the daemon in every pane,
# local or remote, to the binary serving it; `tern remote setup` installs into
# ~/.local/bin, which login shells often lack on PATH), else `tern` on PATH.
# Sets tkg_tern and tkg_tern_src.
tkg_tern_pick() {
	if [ -n "${TERN_BIN-}" ]; then
		tkg_tern=$TERN_BIN tkg_tern_src=TERN_BIN
	elif [ -n "${TERN_EXE-}" ]; then
		tkg_tern=$TERN_EXE tkg_tern_src=TERN_EXE
	else
		tkg_tern=tern tkg_tern_src=PATH
	fi
}

tkg_status() {
	tkg_tern_pick
	printf 'tern-kube guard core: %s\n' "$0"
	printf 'flag table: %s\n' "$(sed -n 's/^# BEGIN generated flags.*\(kubectl v[^;]*\);.*/\1/p' "$0")"
	printf 'kubectl: %s\n' "$(command -v kubectl 2>/dev/null || echo 'not found on PATH')"
	if tkg_t=$(command -v "$tkg_tern" 2>/dev/null); then
		printf 'tern: %s (%s)\n' "$tkg_t" "$tkg_tern_src"
	else
		printf 'tern: %s not found (%s; TERN_EXE is set in Tern panes, TERN_BIN overrides)\n' "$tkg_tern" "$tkg_tern_src"
	fi
	printf 'approval timeout: %ss\n' "${TKUBE_GUARD_TIMEOUT:-600}"
	printf 'guarded verbs: annotate, apply, cordon, delete, drain, edit (after you save), label, patch, rollout restart, rollout undo, rollout pause, rollout resume, scale, uncordon\n'
	if [ "${TERM_PROGRAM-}" != tern ] || [ -z "${TERN_PANE-}" ]; then
		printf 'this shell: not a Tern pane; guarded verbs are refused\n'
	elif [ -z "${TKUBE_SPOOL-}" ]; then
		printf 'this shell: Tern pane without TKUBE_SPOOL (started before the plugin loaded?); guarded verbs are refused until you open a new pane\n'
	else
		printf 'this shell: Tern pane %s; guarded verbs ask for approval (spool %s)\n' "$TERN_PANE" "$TKUBE_SPOOL"
	fi
}

# Checks every approval needs: a Tern pane, the spool, the timeout, kubectl
# and a sha256 tool. Sets tkg_timeout, tkg_program and tkg_sha.
tkg_preflight() {
	[ "${TERM_PROGRAM-}" = tern ] && [ -n "${TERN_PANE-}" ] ||
		tkg_refuse "kubectl $tkg_verb needs approval in Tern, but this shell is not a Tern pane (TERM_PROGRAM=tern and TERN_PANE are required). Run it in a Tern pane."
	[ -n "${TKUBE_SPOOL-}" ] ||
		tkg_refuse "TKUBE_SPOOL is not set: this pane was started before the tern-kube plugin loaded. Open a new Tern pane and retry."
	case $TKUBE_SPOOL in
	/*) ;;
	*) tkg_refuse "TKUBE_SPOOL must be an absolute path: $TKUBE_SPOOL" ;;
	esac
	tkg_timeout=${TKUBE_GUARD_TIMEOUT:-600}
	case $tkg_timeout in
	'' | *[!0-9]* | 0) tkg_refuse "TKUBE_GUARD_TIMEOUT must be a positive number of seconds: $tkg_timeout" ;;
	esac
	tkg_program=$(command -v kubectl) || tkg_refuse "kubectl is not on PATH."
	case $tkg_program in
	/*) ;;
	*) tkg_program=$(pwd -P)/$tkg_program ;;
	esac
	tkg_sha_tool
}

# Writes a request for argv "$@" (inputs from tkg_raw), waits for the
# decision and verifies it. Returns with tkg_decision=approve only when every
# check of PROTOCOL.md "Response" passed, or tkg_decision=deny (reason in
# tkg_r_reason); every other outcome refuses. When tkg_want_ctx is set, the
# resolved context must equal it.
tkg_request_approval() {
	tkg_umask=$(umask)
	umask 077
	tkg_spool=$TKUBE_SPOOL
	[ -L "$tkg_spool" ] && tkg_refuse "the spool $tkg_spool is a symlink."
	[ -d "$tkg_spool" ] || mkdir -p "$tkg_spool" || tkg_refuse "cannot create the spool $tkg_spool."
	[ -O "$tkg_spool" ] || tkg_refuse "the spool $tkg_spool is not owned by you."
	chmod 700 "$tkg_spool" || tkg_refuse "cannot restrict the spool $tkg_spool."
	tkg_spool=$(cd -P -- "$tkg_spool" && pwd -P) || tkg_refuse "cannot enter the spool."
	find "$tkg_spool" -mindepth 1 -maxdepth 1 -type f \( -name 'req-*.json' -o -name 'resp-*.env' -o -name 'cancel-*' \) \
		-mmin +$((tkg_timeout / 60 + 1440)) -exec rm -f {} + 2>/dev/null

	tkg_nonce=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')
	case $tkg_nonce in
	*[!0-9a-f]*) tkg_refuse "cannot read /dev/urandom." ;;
	esac
	[ ${#tkg_nonce} = 32 ] || tkg_refuse "cannot read /dev/urandom."
	tkg_work=$tkg_spool/work-$tkg_nonce
	mkdir "$tkg_work" || tkg_refuse "cannot create $tkg_work."
	trap tkg_on_signal INT TERM HUP

	tkg_compute "$@"
	if [ -n "${tkg_want_ctx-}" ] && [ "$tkg_ctx" != "$tkg_want_ctx" ]; then
		tkg_refuse "the current context changed while kubectl $tkg_verb was running (kubectl uses '$tkg_want_ctx', now '$tkg_ctx')."
	fi
	tkg_req_fp=$tkg_fp
	tkg_req_ctx=$tkg_ctx
	tkg_created=$(date +%s)
	tkg_req=$tkg_spool/req-$tkg_nonce.json
	tkg_resp=$tkg_spool/resp-$tkg_nonce.env
	(set -C && : >"$tkg_req") 2>/dev/null || tkg_refuse "cannot create $tkg_req."
	tkg_write_request "$@" || tkg_refuse "cannot write $tkg_req."

	tkg_err "waiting for approval in Tern (context $tkg_ctx; Ctrl-C cancels)..."
	tkg_tern_pick
	"$tkg_tern" open --wait "$tkg_req" </dev/null >/dev/null &
	tkg_tpid=$!
	(
		trap 'kill "$tkg_s" 2>/dev/null; exit 0' TERM
		sleep "$tkg_timeout" &
		tkg_s=$!
		wait "$tkg_s"
		: >"$tkg_work/timeout"
		kill -TERM "$tkg_tpid" 2>/dev/null
	) &
	tkg_wpid=$!
	wait "$tkg_tpid"
	tkg_st=$?
	tkg_tpid=
	tkg_stop_waiting

	if [ -e "$tkg_work/timeout" ]; then
		tkg_mark_cancel
		tkg_refuse "no decision within ${tkg_timeout}s (TKUBE_GUARD_TIMEOUT); the request was withdrawn."
	fi
	if [ "$tkg_st" != 0 ]; then
		tkg_mark_cancel
		tkg_refuse "'$tkg_tern open --wait' failed (exit $tkg_st); is Tern running? (tern from $tkg_tern_src; in a Tern pane TERN_EXE names the tern binary, TERN_BIN overrides it)"
	fi
	[ -e "$tkg_resp" ] ||
		tkg_refuse "Tern returned without an approval response; the tern-kube approve block did not handle the request (plugin not loaded or disabled? It may have opened in an editor instead)."
	[ -f "$tkg_resp" ] && [ ! -L "$tkg_resp" ] && [ -O "$tkg_resp" ] ||
		tkg_refuse "the approval response $tkg_resp is not a regular file owned by you."

	tkg_r_nonce=
	tkg_r_decision=
	tkg_r_fp=
	tkg_r_ctx=
	tkg_r_at=
	tkg_r_reason=
	tkg_r_ns=
	tkg_r_user=
	tkg_r_audit=
	tkg_dup=
	while IFS= read -r tkg_line || [ -n "$tkg_line" ]; do
		tkg_k=${tkg_line%%=*}
		tkg_v=${tkg_line#*=}
		case $tkg_k in
		nonce | decision | fingerprint | context | approved_at | reason | context_namespace | context_user | audit)
			eval "[ -n \"\${tkg_seen_$tkg_k-}\" ] && tkg_dup=$tkg_k; tkg_seen_$tkg_k=1"
			;;
		esac
		case $tkg_k in
		nonce) tkg_r_nonce=$tkg_v ;;
		decision) tkg_r_decision=$tkg_v ;;
		fingerprint) tkg_r_fp=$tkg_v ;;
		context) tkg_r_ctx=$tkg_v ;;
		approved_at) tkg_r_at=$tkg_v ;;
		reason) tkg_r_reason=$(printf '%s' "$tkg_v" | LC_ALL=C tr -cd '[:print:]') ;;
		context_namespace) tkg_r_ns=$tkg_v ;;
		context_user) tkg_r_user=$tkg_v ;;
		audit) tkg_r_audit=$tkg_v ;;
		esac
	done <"$tkg_resp"
	[ -z "$tkg_dup" ] || tkg_refuse "the approval response repeats '$tkg_dup'; refusing it."
	[ "$tkg_r_nonce" = "$tkg_nonce" ] || tkg_refuse "the approval response belongs to another request (nonce mismatch)."
	case $tkg_r_decision in
	approve) ;;
	deny)
		trap - INT TERM HUP
		tkg_cleanup
		umask "$tkg_umask"
		tkg_decision=deny
		return 0
		;;
	*) tkg_refuse "the approval response has no valid decision." ;;
	esac
	case $tkg_r_at in
	'' | *[!0-9]*) tkg_refuse "the approval response has no valid approved_at." ;;
	esac
	[ "$tkg_r_at" -ge "$tkg_created" ] && [ "$tkg_r_at" -le $((tkg_created + tkg_timeout)) ] &&
		[ "$(date +%s)" -le $((tkg_created + tkg_timeout)) ] ||
		tkg_refuse "the approval is outside the ${tkg_timeout}s window of the request."

	tkg_compute "$@"
	[ "$tkg_ctx" = "$tkg_req_ctx" ] && [ "$tkg_ctx" = "$tkg_r_ctx" ] ||
		tkg_refuse "the target context changed since the request (requested '$tkg_req_ctx', approved '$tkg_r_ctx', now '$tkg_ctx')."
	[ "$tkg_fp" = "$tkg_req_fp" ] && [ "$tkg_fp" = "$tkg_r_fp" ] ||
		tkg_refuse "the command or its input files changed since approval (fingerprint mismatch); run it again to preview the current state."
	tkg_check_target

	trap - INT TERM HUP
	tkg_cleanup
	umask "$tkg_umask"
	tkg_decision=approve
}

# The namespace and user of context $tkg_ctx as kubectl resolves them now:
# sets tkg_t_ns and tkg_t_user. The trailing "." keeps empty values.
tkg_resolve_target() {
	if [ -n "$tkg_flag_kc" ]; then
		set -- --kubeconfig "$tkg_flag_kc"
	else
		set --
	fi
	tkg_t=$(command kubectl "$@" config view --minify --context "$tkg_ctx" \
		-o 'jsonpath={.contexts[0].context.namespace}{"\n"}{.contexts[0].context.user}{"\n"}.' </dev/null) ||
		tkg_refuse "cannot read context '$tkg_ctx' from the kubeconfig ('kubectl config view' failed)."
	tkg_t=${tkg_t%.}
	tkg_t_ns=${tkg_t%%"$tkg_nl"*}
	tkg_t=${tkg_t#*"$tkg_nl"}
	tkg_t_user=${tkg_t%"$tkg_nl"}
}

# kubens and `kubectl config set-context --current --namespace` rewrite the
# context in place: the request, its fingerprint and the context name stay
# equal, so the namespace and user the block previewed (response
# context_namespace and context_user) must equal what kubectl will use. The
# namespace counts only without -n. An edit compares against what kubectl
# loaded when it started (tkg_want_ns, tkg_want_user).
tkg_check_target() {
	[ -n "${tkg_seen_context_namespace-}" ] && [ -n "${tkg_seen_context_user-}" ] ||
		tkg_refuse "the approval response does not name the namespace and user it previewed (tern-kube plugin older than this guard?)."
	if [ -n "${tkg_want_ctx-}" ]; then
		tkg_t_ns=$tkg_want_ns
		tkg_t_user=$tkg_want_user
	else
		tkg_resolve_target
	fi
	[ "$tkg_t_user" = "$tkg_r_user" ] ||
		tkg_refuse "context '$tkg_ctx' now uses user '$tkg_t_user', but the approval previewed '$tkg_r_user'; run it again to preview the current state."
	if [ -z "$tkg_ns_set" ] && [ "$tkg_t_ns" != "$tkg_r_ns" ]; then
		tkg_refuse "context '$tkg_ctx' now defaults to namespace '${tkg_t_ns:-default}', but the approval previewed '${tkg_r_ns:-default}'; run it again to preview the current state."
	fi
	return 0
}

# Replaces the needle $1 in tkg_tpl by $2 (the needles: plugin/lib/mutation/
# audit.luau OUTCOME_FIELDS).
tkg_fill() {
	case $tkg_tpl in
	*"$1"*) tkg_tpl=${tkg_tpl%%"$1"*}$2${tkg_tpl#*"$1"} ;;
	*) return 1 ;;
	esac
}

# Appends the outcome record (template $1, started $2, kubectl's exit status
# $3) to the plugin's audit log next to the spool ($4). Never fails the run.
tkg_record() {
	[ -n "$1" ] || return 0
	tkg_tpl=$1
	tkg_fin=$(date +%s)
	if [ "$3" = 0 ]; then tkg_d=executed; else tkg_d=failed; fi
	if tkg_fill '"decided_at":@' "\"decided_at\":$tkg_fin" &&
		tkg_fill '"decision":"@"' "\"decision\":\"$tkg_d\"" &&
		tkg_fill '"exit_code":@' "\"exit_code\":$3" &&
		tkg_fill '"started_at":@' "\"started_at\":$2" &&
		tkg_fill '"finished_at":@' "\"finished_at\":$tkg_fin" &&
		[ ! -L "$4" ] &&
		(umask 077 && printf '%s\n' "$tkg_tpl" >>"$4") 2>/dev/null; then
		return 0
	fi
	tkg_err "kubectl exited $3, but its outcome could not be added to the audit log $4."
	return 0
}

# Runs the approved argv as a child, so its outcome reaches the audit log;
# exits with kubectl's status. Ctrl-C reaches kubectl (the foreground group)
# and this shell only after kubectl has exited.
tkg_run() {
	tkg_audit_log=${tkg_spool%/*}/audit.log
	tkg_started=$(date +%s)
	trap : INT TERM HUP
	kubectl "$@"
	tkg_st=$?
	trap - INT TERM HUP
	tkg_record "$tkg_r_audit" "$tkg_started" "$tkg_st" "$tkg_audit_log"
	exit "$tkg_st"
}

tkg_guard() {
	tkg_scan_guarded "$@"
	tkg_passes_through && exec kubectl "$@"
	tkg_ifs=$IFS
	IFS='
'
	set -f
	for tkg_line in $tkg_raw; do
		tkg_check_value "${tkg_line%% *}" "${tkg_line#* }"
	done
	set +f
	IFS=$tkg_ifs

	tkg_preflight
	tkg_request_approval kubectl "$@"
	if [ "$tkg_decision" = deny ]; then
		if [ -n "$tkg_r_reason" ]; then
			tkg_err "denied in Tern: $tkg_r_reason"
		else
			tkg_err "denied in Tern; nothing was executed."
		fi
		exit 1
	fi
	tkg_run "$@"
}

# Single-quoted sh literal of $1 (any bytes, newlines included).
tkg_shq() {
	tkg_q=$1
	tkg_o=
	while :; do
		case $tkg_q in
		*\'*)
			tkg_o="$tkg_o${tkg_q%%\'*}'\\''"
			tkg_q=${tkg_q#*\'}
			;;
		*) break ;;
		esac
	done
	printf "'%s%s'" "$tkg_o" "$tkg_q"
}

tkg_has_space() {
	case $1 in
	*' '* | *'	'* | *'
'*) return 0 ;;
	esac
	return 1
}

tkg_tmpdir() {
	tkg_tmp=${TMPDIR:-/tmp}
	while :; do
		case $tkg_tmp in
		/) break ;;
		*/) tkg_tmp=${tkg_tmp%/} ;;
		*) break ;;
		esac
	done
}

# `kubectl edit` (shell/PROTOCOL.md "Edit approvals"): kubectl runs with
# KUBE_EDITOR pointing at a hook in a private directory; the hook runs the
# real editor and asks for approval after each save.
tkg_edit() {
	tkg_scan_guarded "$@"
	[ -z "$tkg_unknown2" ] ||
		tkg_refuse "kubectl edit with $tkg_unknown2 cannot be previewed (unknown to the guard, or missing its value)."
	[ -z "${TKUBE_EDIT_DIR-}" ] ||
		tkg_refuse "kubectl edit is already running under the guard here (TKUBE_EDIT_DIR is set); nested edits are not supported."
	tkg_preflight
	tkg_tern_pick
	command -v "$tkg_tern" >/dev/null 2>&1 ||
		tkg_refuse "$tkg_tern ($tkg_tern_src) is not on PATH; kubectl edit needs it to ask for approval after you save. In a Tern pane TERN_EXE names the tern binary; set TERN_BIN to override."
	tkg_tmpdir
	case $tkg_tmp in
	/*) ;;
	*) tkg_refuse "TMPDIR must be an absolute path for kubectl edit: $tkg_tmp" ;;
	esac
	# kubectl splits KUBE_EDITOR on spaces, so the hook path must have none.
	tkg_has_space "$tkg_tmp" &&
		tkg_refuse "TMPDIR contains whitespace ($tkg_tmp), so kubectl could not run the guard's editor hook there; set TMPDIR to a path without spaces."
	tkg_resolve_context
	tkg_resolve_target
	case $0 in
	/*) tkg_core=$0 ;;
	*/*) tkg_core=$(pwd -P)/$0 ;;
	*) tkg_core=$(command -v -- "$0") || tkg_refuse "cannot locate the guard core." ;;
	esac

	tkg_umask=$(umask)
	umask 077
	tkg_wrap_dir=$(mktemp -d "$tkg_tmp/tkube-edit.XXXXXX") || tkg_refuse "cannot create a directory in $tkg_tmp."
	tkg_wrap_dir=$(cd -P -- "$tkg_wrap_dir" && pwd -P) || tkg_refuse "cannot enter the edit directory."
	tkg_has_space "$tkg_wrap_dir" &&
		tkg_refuse "TMPDIR resolves to a path with whitespace ($tkg_wrap_dir); set TMPDIR to a path without spaces."
	if ! {
		printf '#!/bin/sh\nexec '
		tkg_shq "$tkg_core"
		printf ' edit-hook "$@"\n'
	} >"$tkg_wrap_dir/hook" || ! chmod 700 "$tkg_wrap_dir/hook"; then
		tkg_refuse "cannot write the editor hook."
	fi
	tkg_args=
	for tkg_t in "$@"; do
		tkg_args="$tkg_args $(tkg_shq "$tkg_t")"
	done
	{
		printf 'tkg_e_args='
		tkg_shq "$tkg_args"
		printf '\ntkg_e_program='
		tkg_shq "$tkg_program"
		printf '\ntkg_e_ctx='
		tkg_shq "$tkg_ctx"
		printf '\ntkg_e_ns='
		tkg_shq "$tkg_t_ns"
		printf '\ntkg_e_user='
		tkg_shq "$tkg_t_user"
		printf '\n'
	} >"$tkg_wrap_dir/request" || tkg_refuse "cannot write $tkg_wrap_dir/request."
	umask "$tkg_umask"

	tkg_real=${KUBE_EDITOR:-${EDITOR:-vi}}
	# Ctrl-C reaches kubectl and the hook in the foreground group; the trap
	# runs once kubectl has exited.
	tkg_sig=
	trap 'tkg_sig=1' INT TERM HUP
	KUBE_EDITOR=$tkg_wrap_dir/hook TKUBE_EDIT_DIR=$tkg_wrap_dir TKUBE_EDIT_REAL=$tkg_real kubectl "$@"
	tkg_st=$?
	trap - INT TERM HUP
	[ -z "$tkg_sig" ] || tkg_st=130
	# A denial makes kubectl see an unchanged file and exit 0 ("Edit
	# cancelled"); the guard reports it like every other denial.
	[ -e "$tkg_wrap_dir/denied" ] && [ "$tkg_st" = 0 ] && tkg_st=1
	if [ -f "$tkg_wrap_dir/approved" ]; then
		# Sets tkg_a_tpl, tkg_a_started and tkg_a_log (written by the hook).
		# shellcheck source=/dev/null
		. "$tkg_wrap_dir/approved" &&
			tkg_record "$tkg_a_tpl" "$tkg_a_started" "$tkg_st" "$tkg_a_log"
	fi
	rm -rf "$tkg_wrap_dir"
	exit "$tkg_st"
}

# Runs the editor command $TKUBE_EDIT_REAL on $1 the way kubectl does: no
# space: one word; spaces but no quote or backslash: split on each single
# space; otherwise through "$SHELL -c" with the path in Go %q quoting.
tkg_run_editor() {
	tkg_ef=$1
	case $TKUBE_EDIT_REAL in
	*' '*) ;;
	*)
		"$TKUBE_EDIT_REAL" "$tkg_ef"
		return
		;;
	esac
	case $TKUBE_EDIT_REAL in
	*[\"\'\\]*)
		tkg_q=$tkg_ef
		tkg_o=
		while [ -n "$tkg_q" ]; do
			tkg_c=${tkg_q%"${tkg_q#?}"}
			tkg_q=${tkg_q#?}
			case $tkg_c in
			\\ | \") tkg_o="$tkg_o\\$tkg_c" ;;
			*) tkg_o=$tkg_o$tkg_c ;;
			esac
		done
		"${SHELL:-/bin/bash}" -c "$TKUBE_EDIT_REAL \"$tkg_o\""
		return
		;;
	esac
	tkg_rest=$TKUBE_EDIT_REAL
	set --
	while :; do
		case $tkg_rest in
		*' '*)
			set -- "$@" "${tkg_rest%% *}"
			tkg_rest=${tkg_rest#* }
			;;
		*)
			set -- "$@" "$tkg_rest" "$tkg_ef"
			break
			;;
		esac
	done
	"$@"
}

# Equal once `#` lines (always comments in kubectl's YAML and JSON files)
# are dropped: kubectl then cancels the round itself.
tkg_same_edit() {
	grep -v '^#' "$1" >"$tkg_dir/cmp.a"
	grep -v '^#' "$2" >"$tkg_dir/cmp.b"
	cmp -s "$tkg_dir/cmp.a" "$tkg_dir/cmp.b"
}

tkg_edit_restore() {
	cat "$tkg_dir/round.before" >"$tkg_file" 2>/dev/null
}

tkg_edit_save() {
	if tkg_copy=$(mktemp "$tkg_tmp/kubectl-edit-denied-XXXXXX") && cat "$tkg_file" >"$tkg_copy"; then
		tkg_err "your edit is saved at $tkg_copy"
	else
		tkg_err "could not save a copy of your edit."
	fi
}

# EXIT trap of the hook: unless approved, kubectl must find the bytes it
# wrote this round, so it applies nothing.
tkg_edit_exit() {
	case $tkg_hook_state in
	editing) tkg_edit_restore ;;
	pending)
		tkg_edit_save
		tkg_edit_restore
		;;
	esac
	return 0
}

# `tern-kube-guard edit-hook FILE`: KUBE_EDITOR of a guarded kubectl edit,
# run once per round.
tkg_edit_hook() {
	tkg_hint="the edit was not applied."
	tkg_sig_status=1
	tkg_verb=edit
	tkg_guarded=edit
	tkg_dir=${TKUBE_EDIT_DIR-}
	if [ $# != 1 ] || [ -z "$tkg_dir" ]; then
		echo "usage: TKUBE_EDIT_DIR=DIR tern-kube-guard edit-hook FILE (run by a guarded kubectl edit)" >&2
		exit 2
	fi
	case $tkg_dir in
	/*) ;;
	*) tkg_refuse "TKUBE_EDIT_DIR must be an absolute path: $tkg_dir" ;;
	esac
	[ -d "$tkg_dir" ] && [ ! -L "$tkg_dir" ] && [ -O "$tkg_dir" ] && [ -f "$tkg_dir/request" ] ||
		tkg_refuse "$tkg_dir is not the guard's edit directory."
	tkg_file=$1
	case $tkg_file in
	/*) ;;
	*) tkg_file=$(pwd -P)/$tkg_file ;;
	esac
	[ -f "$tkg_file" ] || tkg_refuse "$tkg_file is not a regular file."
	tkg_tmpdir
	umask 077
	tkg_orig=$tkg_dir/original.yaml
	case $tkg_file in
	*.json) tkg_orig=$tkg_dir/original.json ;;
	esac
	# kubectl computes every round's patch against its first fetch.
	[ -e "$tkg_orig" ] || cp "$tkg_file" "$tkg_orig" || tkg_refuse "cannot copy $tkg_file."
	cp "$tkg_file" "$tkg_dir/round.before" || tkg_refuse "cannot copy $tkg_file."
	tkg_hook_state=editing
	trap tkg_edit_exit EXIT

	tkg_run_editor "$tkg_file"
	tkg_st=$?
	[ "$tkg_st" = 0 ] || exit "$tkg_st"
	if tkg_same_edit "$tkg_file" "$tkg_dir/round.before"; then
		tkg_hook_state=settled
		exit 0
	fi
	tkg_hook_state=pending

	# Sets tkg_e_args, tkg_e_program, tkg_e_ctx, tkg_e_ns and tkg_e_user
	# (written by tkg_edit).
	# shellcheck source=/dev/null
	. "$tkg_dir/request" || tkg_refuse "cannot read $tkg_dir/request."
	# shellcheck disable=SC2154
	eval "set -- $tkg_e_args"
	tkg_scan_guarded "$@"
	tkg_raw="p $tkg_file
p $tkg_orig
"
	tkg_edit_file=$tkg_file
	tkg_edit_orig=$tkg_orig
	tkg_preflight
	# shellcheck disable=SC2154
	tkg_program=$tkg_e_program
	# shellcheck disable=SC2154
	tkg_want_ctx=$tkg_e_ctx
	# shellcheck disable=SC2154
	tkg_want_ns=$tkg_e_ns
	# shellcheck disable=SC2154
	tkg_want_user=$tkg_e_user
	tkg_request_approval kubectl "$@"
	if [ "$tkg_decision" = approve ]; then
		# kubectl applies the file once this hook exits; tkg_edit records
		# its outcome.
		{
			printf 'tkg_a_tpl='
			tkg_shq "$tkg_r_audit"
			printf '\ntkg_a_started=%s\ntkg_a_log=' "$(date +%s)"
			tkg_shq "${tkg_spool%/*}/audit.log"
			printf '\n'
		} >"$tkg_dir/approved" || tkg_err "cannot note the approval for the audit log."
		tkg_hook_state=settled
		exit 0
	fi
	if [ -n "$tkg_r_reason" ]; then
		tkg_err "denied in Tern: $tkg_r_reason"
	else
		tkg_err "denied in Tern; the object was not changed."
	fi
	: >"$tkg_dir/denied"
	tkg_edit_save
	tkg_edit_restore
	tkg_hook_state=settled
	exit 0
}

tkg_hint="nothing was executed. To run it anyway, without preview or confirmation, use: command kubectl ..."
tkg_sig_status=130
case ${1-} in
kubectl)
	shift
	tkg_guarded=
	tkg_find_verb "$@"
	[ -n "$tkg_guarded" ] || exec kubectl "$@"
	if [ "$tkg_guarded" = edit ]; then
		tkg_edit "$@"
	fi
	tkg_guard "$@"
	;;
edit-hook)
	shift
	tkg_edit_hook "$@"
	;;
status)
	tkg_status
	;;
*)
	echo "usage: tern-kube-guard kubectl [ARGS...] | tern-kube-guard status" >&2
	exit 2
	;;
esac
