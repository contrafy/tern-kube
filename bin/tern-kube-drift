#!/bin/sh
# tern-kube-drift: report drift between Kubernetes manifests and a cluster.
#
# Runs `kubectl diff` (server-side dry run, never mutates) for one source and
# reports per-resource changes as text, Markdown (PR comments, CI summaries)
# or JSON. Segmentation follows plugin/lib/mutation/diffseg.luau in
# github.com/contrafy/tern-kube so the CLI and the Tern plugin agree. With
# several contexts the same source is diffed against each in turn and the
# report gains a resource-by-context matrix.
#
# Requires only a POSIX shell, awk, sed, sort, mktemp and kubectl (helm for
# --helm). Exit status: 0 no drift, 1 drift, 2 error.

set -u
if [ -n "${ZSH_VERSION-}" ]; then emulate sh; fi

VERSION=0.2.0
prog=tern-kube-drift

usage() {
	cat <<'EOF'
usage: tern-kube-drift SOURCE [options]

SOURCE (exactly one):
  -f, --filename PATH        manifest file or directory (repeatable)
  -R, --recursive            with -f: recurse into directories
  -k, --kustomize DIR        kustomization directory
  --helm CHART --release R   render a chart with `helm template`; with --helm,
                             -f/--values FILE are values files (repeatable)

Options:
  --context C                kubeconfig context (default: current context);
                             repeatable: one report across several contexts
  --all-contexts             every context in the kubeconfig
  --kubeconfig K             kubeconfig file (default: kubectl's)
  -n, --namespace NS         namespace for objects without one
  --format text|markdown|json  output format (default text)
  --max-diff-lines N         show at most N diff lines per resource (0 = all)
  --max-bytes N              markdown/text: keep output under N bytes by
                             dropping whole per-resource diffs (0 = no limit)
  --unmanaged KINDS|auto     also list live objects of KINDS (comma-separated
                             kubectl resource names; `auto` = kinds in the
                             source) that no manifest declares, in the
                             namespaces the source covers
  -h, --help                 this help
  --version                  print the version

Environment: KUBECTL (default kubectl), HELM (default helm).
Exit status: 0 no drift, 1 drift, 2 error (with several contexts: 2 if any
context failed, its error is part of the report).
EOF
}

die() {
	printf '%s: %s\n' "$prog" "$*" >&2
	exit 2
}

# Single-quotes a word for later `eval "set -- ..."`.
q() {
	printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

need() {
	[ $# -ge 2 ] || die "$1 needs a value"
}

files=
nfiles=0
recursive=0
kdir=
chart=
release=
values=
contexts=
ncontexts=0
all_contexts=0
context=
kubeconfig=
namespace=
format=text
max_lines=0
max_bytes=0
unmanaged=

add_context() {
	new=$1
	eval "set -- $contexts"
	for c in "$@"; do
		[ "$c" != "$new" ] || die "--context $new given twice"
	done
	contexts="$contexts $(q "$new")"
	ncontexts=$((ncontexts + 1))
}

while [ $# -gt 0 ]; do
	case $1 in
	-f | --filename)
		need "$@"
		files="$files $(q "$2")"
		nfiles=$((nfiles + 1))
		shift 2
		;;
	--filename=*)
		files="$files $(q "${1#*=}")"
		nfiles=$((nfiles + 1))
		shift
		;;
	--values)
		need "$@"
		values="$values $(q "$2")"
		shift 2
		;;
	--values=*)
		values="$values $(q "${1#*=}")"
		shift
		;;
	-R | --recursive)
		recursive=1
		shift
		;;
	-k | --kustomize)
		need "$@"
		[ -z "$kdir" ] || die "-k given twice"
		kdir=$2
		shift 2
		;;
	--kustomize=*)
		[ -z "$kdir" ] || die "-k given twice"
		kdir=${1#*=}
		shift
		;;
	--helm)
		need "$@"
		chart=$2
		shift 2
		;;
	--helm=*)
		chart=${1#*=}
		shift
		;;
	--release)
		need "$@"
		release=$2
		shift 2
		;;
	--release=*)
		release=${1#*=}
		shift
		;;
	--context)
		need "$@"
		add_context "$2"
		shift 2
		;;
	--context=*)
		add_context "${1#*=}"
		shift
		;;
	--all-contexts)
		all_contexts=1
		shift
		;;
	--kubeconfig)
		need "$@"
		kubeconfig=$2
		shift 2
		;;
	--kubeconfig=*)
		kubeconfig=${1#*=}
		shift
		;;
	-n | --namespace)
		need "$@"
		namespace=$2
		shift 2
		;;
	--namespace=*)
		namespace=${1#*=}
		shift
		;;
	--format)
		need "$@"
		format=$2
		shift 2
		;;
	--format=*)
		format=${1#*=}
		shift
		;;
	--max-diff-lines)
		need "$@"
		max_lines=$2
		shift 2
		;;
	--max-diff-lines=*)
		max_lines=${1#*=}
		shift
		;;
	--max-bytes)
		need "$@"
		max_bytes=$2
		shift 2
		;;
	--max-bytes=*)
		max_bytes=${1#*=}
		shift
		;;
	--unmanaged)
		need "$@"
		unmanaged=$2
		shift 2
		;;
	--unmanaged=*)
		unmanaged=${1#*=}
		shift
		;;
	-h | --help)
		usage
		exit 0
		;;
	--version)
		printf '%s %s\n' "$prog" "$VERSION"
		exit 0
		;;
	*)
		printf '%s: unknown argument: %s\n\n' "$prog" "$1" >&2
		usage >&2
		exit 2
		;;
	esac
done

case $format in
text | markdown | json) ;;
*) die "--format must be text, markdown or json" ;;
esac
case $max_lines in
'' | *[!0-9]*) die "--max-diff-lines must be a non-negative integer" ;;
esac
case $max_bytes in
'' | *[!0-9]*) die "--max-bytes must be a non-negative integer" ;;
esac
if [ "$all_contexts" = 1 ] && [ "$ncontexts" -gt 0 ]; then
	die "--all-contexts and --context are mutually exclusive"
fi
if [ "$ncontexts" -gt 1 ]; then
	eval "set -- $contexts"
	for c in "$@"; do
		[ -n "$c" ] || die "--context needs a name when given more than once"
	done
fi
if [ -n "$chart" ]; then
	[ -z "$kdir" ] || die "--helm and -k are mutually exclusive"
	[ -n "$release" ] || die "--helm needs --release"
	[ "$recursive" = 0 ] || die "-R does not apply to --helm"
	values="$files$values"
	files=
	src_type=helm
	label="helm $chart (release $release)"
elif [ -n "$kdir" ]; then
	[ "$nfiles" = 0 ] || die "-f and -k are mutually exclusive"
	[ -z "$release$values" ] || die "--release/--values need --helm"
	[ "$recursive" = 0 ] || die "-R does not apply to -k"
	src_type=kustomize
	label=$kdir
else
	[ "$nfiles" -gt 0 ] || die "no source: give -f PATH, -k DIR or --helm CHART"
	[ -z "$release$values" ] || die "--release/--values need --helm"
	src_type='file'
	eval "set -- $files"
	label=$*
fi

kubectl_bin=${KUBECTL:-kubectl}
helm_bin=${HELM:-helm}
command -v "$kubectl_bin" >/dev/null 2>&1 || die "kubectl not found (set KUBECTL)"

# kubectl diff must print its built-in `diff -u -N` output.
unset KUBECTL_EXTERNAL_DIFF

tmp=$(mktemp -d "${TMPDIR:-/tmp}/tern-kube-drift.XXXXXX") || die "cannot create a temp dir"
trap 'rm -rf "$tmp"' EXIT
trap 'exit 2' HUP INT TERM

kc() {
	"$kubectl_bin" ${kubeconfig:+--kubeconfig "$kubeconfig"} ${context:+--context "$context"} "$@"
}

if [ "$all_contexts" = 1 ]; then
	kc config get-contexts -o name >"$tmp/contexts" 2>"$tmp/contexts.err" || {
		cat "$tmp/contexts.err" >&2
		die "cannot list contexts (kubectl config get-contexts)"
	}
	while IFS= read -r c || [ -n "$c" ]; do
		[ -n "$c" ] || continue
		contexts="$contexts $(q "$c")"
		ncontexts=$((ncontexts + 1))
	done <"$tmp/contexts"
	[ "$ncontexts" -gt 0 ] || die "no contexts in the kubeconfig"
fi
# One context keeps the single-context report (JSON version 1); two or more
# give the combined report (JSON version 2).
multi=0
if [ "$ncontexts" -gt 1 ]; then
	multi=1
else
	eval "set -- $contexts"
	context=${1-}
fi

if [ "$src_type" = helm ]; then
	command -v "$helm_bin" >/dev/null 2>&1 || die "helm not found (set HELM)"
	eval "set -- $values"
	for v in "$@"; do
		set -- "$@" -f "$v"
		shift
	done
	if ! "$helm_bin" template "$release" "$chart" ${namespace:+--namespace "$namespace"} "$@" \
		>"$tmp/rendered.yaml" 2>"$tmp/helm.err"; then
		cat "$tmp/helm.err" >&2
		die "helm template failed"
	fi
	files=" $(q "$tmp/rendered.yaml")"
fi

# Source flags for kubectl diff / apply --dry-run=client.
source_args() {
	if [ "$src_type" = kustomize ]; then
		set -- -k "$kdir"
	else
		eval "set -- $files"
		for f in "$@"; do
			set -- "$@" -f "$f"
			shift
		done
		[ "$recursive" = 0 ] || set -- "$@" -R
	fi
	for a in "$@"; do
		printf '%s ' "$(q "$a")"
	done
}
src=$(source_args)

# show_err FILE: kubectl's stderr, tagged with the context when there are several.
show_err() {
	[ -s "$1" ] || return 0
	if [ "$multi" = 0 ]; then
		cat "$1" >&2
		return 0
	fi
	while IFS= read -r line || [ -n "$line" ]; do
		printf '[%s] %s\n' "$context" "$line" >&2
	done <"$1"
}

# fail MSG [STDERR_FILE]: with one context, exit 2 as always. With several,
# record MSG (plus kubectl's last stderr line) as this context's error and
# let the caller move on to the next context.
fail() {
	[ "$multi" = 1 ] || die "$1"
	printf '%s: [%s] %s\n' "$prog" "$context" "$1" >&2
	msg=$1
	if [ -n "${2-}" ] && [ -s "$2" ]; then
		last=$(LC_ALL=C awk 'NF { l = $0 } END { gsub(/[\t\r]/, " ", l); print l }' "$2")
		[ -z "$last" ] || msg="$msg: $last"
	fi
	printf '%s\n' "$msg" >"$cdir/error"
}

# collect DIR: runs the read-only kubectl calls for $context into DIR: diff,
# the source's objects (manifest.tsv: with --unmanaged or several contexts)
# and unmanaged.tsv. Returns 1 after fail.
collect() {
	cdir=$1
	eval "set -- $src"
	kc diff ${namespace:+-n "$namespace"} "$@" >"$cdir/diff" 2>"$cdir/diff.err"
	rc=$?
	show_err "$cdir/diff.err"
	case $rc in
	0 | 1) ;;
	*)
		fail "kubectl diff failed (exit $rc)" "$cdir/diff.err"
		return 1
		;;
	esac
	if [ "$rc" = 1 ] && ! grep -Eq '^(@@ |Binary files )' "$cdir/diff"; then
		fail "kubectl diff exited 1 without a diff" "$cdir/diff.err"
		return 1
	fi

	: >"$cdir/unmanaged.tsv"
	[ -n "$unmanaged" ] || [ "$multi" = 1 ] || return 0
	tpl='{{define "o"}}{{.apiVersion}}{{"\t"}}{{.kind}}{{"\t"}}{{.metadata.namespace}}{{"\t"}}{{.metadata.name}}{{"\n"}}{{end}}{{if eq .kind "List"}}{{range .items}}{{template "o" .}}{{end}}{{else}}{{template "o" .}}{{end}}'
	if ! kc apply --dry-run=client ${namespace:+-n "$namespace"} "$@" -o go-template="$tpl" \
		>"$cdir/manifest.tsv" 2>"$cdir/apply.err"; then
		show_err "$cdir/apply.err"
		fail "cannot list the source's objects (kubectl apply --dry-run=client)" "$cdir/apply.err"
		return 1
	fi
	[ -n "$unmanaged" ] || return 0
	if [ "$unmanaged" = auto ]; then
		kinds=$(LC_ALL=C awk -F '\t' '
			{ g = $1; if (index(g, "/")) sub(/\/.*/, "", g); else g = ""
			  k = $2; if (g != "") k = k "." g
			  if (!(k in seen)) { seen[k] = 1; out = out (out == "" ? "" : ",") k } }
			END { print out }' "$cdir/manifest.tsv")
	else
		kinds=$unmanaged
	fi
	namespaces=$(LC_ALL=C awk -F '\t' '$3 != "" && $3 != "<no value>" { print $3 }' "$cdir/manifest.tsv" | LC_ALL=C sort -u)
	if [ -n "$namespace" ]; then
		namespaces=$(printf '%s\n%s\n' "$namespaces" "$namespace" | LC_ALL=C sort -u)
	fi
	ltpl='{{range .items}}{{.apiVersion}}{{"\t"}}{{.kind}}{{"\t"}}{{.metadata.namespace}}{{"\t"}}{{.metadata.name}}{{"\t"}}{{if .metadata.ownerReferences}}owned{{else}}-{{end}}{{"\t"}}{{if .type}}{{.type}}{{else}}-{{end}}{{"\t"}}{{with .metadata.labels}}{{index . "kubernetes.io/bootstrapping"}}{{end}}{{"\n"}}{{end}}'
	: >"$cdir/live.tsv"
	old_ifs=$IFS
	set -f
	IFS=,
	for kind in $kinds; do
		IFS=$old_ifs
		[ -n "$kind" ] || continue
		if [ -n "$namespaces" ]; then
			for ns in $namespaces; do
				kc get "$kind" -n "$ns" -o go-template="$ltpl" >>"$cdir/live.tsv" 2>"$cdir/get.err" || {
					show_err "$cdir/get.err"
					set +f
					fail "cannot list $kind in namespace $ns" "$cdir/get.err"
					return 1
				}
			done
		else
			kc get "$kind" -o go-template="$ltpl" >>"$cdir/live.tsv" 2>"$cdir/get.err" || {
				show_err "$cdir/get.err"
				set +f
				fail "cannot list $kind" "$cdir/get.err"
				return 1
			}
		fi
	done
	IFS=$old_ifs
	set +f
	printf '%s\n' "$namespaces" >"$cdir/namespaces"
	LC_ALL=C awk -F '\t' -v OFS='\t' '
		function nv(s) { return s == "<no value>" ? "" : s }
		function grp(av) { return index(av, "/") ? substr(av, 1, index(av, "/") - 1) : "" }
		function ver(av) { return index(av, "/") ? substr(av, index(av, "/") + 1) : av }
		FILENAME == ARGV[1] { if ($0 != "") cover[$0] = 1; next }
		FILENAME == ARGV[2] { declared[grp($1) SUBSEP $2 SUBSEP nv($3) SUBSEP $4] = 1; next }
		{
			ns = nv($3); kind = $2; name = $4
			if (ns != "" && !(ns in cover)) next
			if ($5 == "owned") next
			if (kind == "Event" || kind == "Endpoints" || kind == "EndpointSlice" || kind == "Lease") next
			if (kind == "ServiceAccount" && name == "default") next
			if (kind == "ConfigMap" && name == "kube-root-ca.crt") next
			if (kind == "Secret" && ($6 == "helm.sh/release.v1" || $6 == "kubernetes.io/service-account-token")) next
			if (kind == "Namespace" && (name == "default" || name ~ /^kube-/)) next
			if (nv($7) != "" || name ~ /^system:/) next
			id = grp($1) SUBSEP kind SUBSEP ns SUBSEP name
			if (id in declared || id in seen) next
			seen[id] = 1
			print grp($1), ver($1), kind, ns, name
		}' "$cdir/namespaces" "$cdir/manifest.tsv" "$cdir/live.tsv" |
		LC_ALL=C sort -t "$(printf '\t')" -k3,3 -k4,4 -k5,5 >"$cdir/unmanaged.tsv"
}

errors=0
if [ "$multi" = 0 ]; then
	ctx_name=$context
	if [ -z "$ctx_name" ]; then
		ctx_name=$(kc config current-context 2>/dev/null) || ctx_name=
	fi
	mkdir "$tmp/1" || die "cannot create a temp dir"
	collect "$tmp/1"
else
	ctx_name=
	i=0
	eval "set -- $contexts"
	for context in "$@"; do
		i=$((i + 1))
		mkdir "$tmp/$i" || die "cannot create a temp dir"
		printf '%s\n' "$context" >"$tmp/$i/name"
		collect "$tmp/$i" || errors=$((errors + 1))
	done
fi

TKD_FORMAT=$format TKD_MAX_LINES=$max_lines TKD_MAX_BYTES=$max_bytes TKD_LABEL=$label \
	TKD_SOURCE_TYPE=$src_type TKD_CONTEXT=$ctx_name TKD_NAMESPACE=$namespace \
	TKD_DIR=$tmp TKD_N=$((ncontexts > 1 ? ncontexts : 1)) TKD_MULTI=$multi TKD_UNMANAGED_ON=${unmanaged:+1} \
	LC_ALL=C awk '
# Port of plugin/lib/mutation/diffseg.luau M.parse; keep the two in step
# (tests/shell/drift checks them against the same golden inputs).
function basename(p) {
	if (match(p, /[^\/]+$/)) return substr(p, RSTART)
	return p
}
function headerPath(line,   b, t) {
	b = substr(line, 5)
	t = index(b, "\t")
	return t ? substr(b, 1, t - 1) : b
}
function isVersion(t) {
	return t ~ /^v[0-9]+$/ || t ~ /^v[0-9]+[a-z]+[0-9]+$/
}
function identity(f,   p, np, i, j, nm, g) {
	np = split(f, p, "[.]")
	for (i = 1; i <= np - 3; i++) {
		if (isVersion(p[i]) && p[i + 1] ~ /^[A-Z]/) {
			nm = p[i + 3]
			for (j = i + 4; j <= np; j++) nm = nm "." p[j]
			if (nm == "") return 0
			g = ""
			if (i > 1) { g = p[1]; for (j = 2; j < i; j++) g = g "." p[j] }
			ID_hg = (i > 1); ID_g = g; ID_v = p[i]; ID_k = p[i + 1]; ID_ns = p[i + 2]; ID_nm = nm
			return 1
		}
	}
	return 0
}
function setKey(s, key) {
	S_key[s] = key
	S_id[s] = identity(key)
	if (S_id[s]) {
		S_hg[s] = ID_hg; S_g[s] = ID_g; S_v[s] = ID_v; S_k[s] = ID_k; S_ns[s] = ID_ns; S_nm[s] = ID_nm
	}
}
function push(s, line) { S_n[s]++; SL[s, S_n[s]] = line }
function note(t) { NN++; NOTE[NN] = t }
function diffLineKey(line,   rest, ok) {
	ok = 0
	if (line ~ /^diff -u -N ./) { rest = substr(line, 12); ok = 1 }
	else if (match(line, WSDIFF) && RLENGTH < length(line)) { rest = substr(line, RLENGTH + 1); ok = 1 }
	if (!ok || rest ~ WSEND) return ""
	match(rest, LASTTOK)
	return basename(substr(rest, RSTART))
}
function hunkHeader(line,   r, m) {
	if (!match(line, /^@@ -[0-9]+,?[0-9]* \+[0-9]+,?[0-9]* @@/)) return 0
	r = substr(line, 5)
	match(r, /^[0-9]+/); r = substr(r, RLENGTH + 1)
	if (substr(r, 1, 1) == ",") r = substr(r, 2)
	match(r, /^[0-9]*/); m = substr(r, 1, RLENGTH); r = substr(r, RLENGTH + 1)
	HH_old = (m == "") ? 1 : m + 0
	r = substr(r, 3)
	match(r, /^[0-9]+/); r = substr(r, RLENGTH + 1)
	if (substr(r, 1, 1) == ",") r = substr(r, 2)
	match(r, /^[0-9]*/); m = substr(r, 1, RLENGTH)
	HH_new = (m == "") ? 1 : m + 0
	return 1
}
function start(key, first) {
	finish()
	cur = ++NSEG
	setKey(cur, key)
	S_act[cur] = "unknown"; S_add[cur] = 0; S_rem[cur] = 0; S_bin[cur] = 0; S_n[cur] = 0
	push(cur, first)
	oE = 0; nE = 0; oS = 0; nS = 0
}
function finish(   s, a) {
	if (!cur) return
	s = cur
	if (hk && (oL > 0 || nL > 0)) note(S_key[s] ": hunk ended early")
	if (S_bin[s]) S_act[s] = "unknown"
	else if (oE && !oS && nS) S_act[s] = "create"
	else if (nE && !nS && oS) S_act[s] = "delete"
	else if (oS || nS) S_act[s] = "modify"
	a = S_act[s]
	CC[CUR, a]++
	CADD[CUR] += S_add[s]; CREM[CUR] += S_rem[s]
	cur = 0; hk = 0
}
function parse(   i, line, c, key, merged) {
	cur = 0; hk = 0; i = 1
	while (i <= NL) {
		line = L[i]
		if (hk && (oL > 0 || nL > 0)) {
			c = substr(line, 1, 1)
			if (c == " " || line == "") { oL--; nL-- }
			else if (c == "-") { oL--; S_rem[cur]++ }
			else if (c == "+") { nL--; S_add[cur]++ }
			else if (c != "\\") { note(S_key[cur] ": hunk ended early"); hk = 0; continue }
			push(cur, line); i++; continue
		}
		key = diffLineKey(line)
		if (key != "") {
			start(key, line)
		} else if (substr(line, 1, 4) == "--- " && substr(L[i + 1], 1, 4) == "+++ ") {
			merged = basename(headerPath(L[i + 1]))
			if (!cur || S_n[cur] > 1) start(merged, line)
			else {
				push(cur, line)
				if (!S_id[cur]) setKey(cur, merged)
			}
			push(cur, L[i + 1])
			i += 2; continue
		} else if (cur && substr(line, 1, 3) == "@@ ") {
			if (!hunkHeader(line)) {
				note(S_key[cur] ": unreadable hunk header " line)
				push(cur, line); i++; continue
			}
			if (HH_old == 0) oE = 1; else oS = 1
			if (HH_new == 0) nE = 1; else nS = 1
			hk = 1; oL = HH_old; nL = HH_new
			push(cur, line)
		} else if (cur && line ~ /^Binary files .+ differ$/) {
			S_bin[cur] = 1
			push(cur, line)
		} else if (line != "") {
			note(line)
		}
		i++
	}
	finish()
}

function nv(s) { return s == "<no value>" ? "" : s }
function grp(av) { return index(av, "/") ? substr(av, 1, index(av, "/") - 1) : "" }
function ver(av) { return index(av, "/") ? substr(av, index(av, "/") + 1) : av }
# load(c): context c from TKD_DIR/c. Segments, notes, unmanaged and declared
# objects are numbered across contexts; C_*0[c] is the offset of c.
function load(c,   d, f, line, n, x) {
	d = DIR "/" c
	f = d "/name"
	C_name[c] = (getline line < f) > 0 ? line : CTX
	close(f)
	f = d "/error"
	C_ok[c] = 1
	if ((getline line < f) > 0) { C_ok[c] = 0; C_err[c] = line }
	close(f)
	C_s0[c] = NSEG; C_n0[c] = NN; C_u0[c] = NU; C_d0[c] = ND
	if (C_ok[c]) {
		split("", L); NL = 0
		f = d "/diff"
		while ((getline line < f) > 0) { sub(/\r$/, "", line); L[++NL] = line }
		close(f)
		CUR = c
		parse()
		if (UON) {
			f = d "/unmanaged.tsv"
			while ((getline line < f) > 0) {
				n = split(line, x, "\t")
				if (n < 5) continue
				NU++; U_g[NU] = x[1]; U_v[NU] = x[2]; U_k[NU] = x[3]; U_ns[NU] = x[4]; U_nm[NU] = x[5]
			}
			close(f)
		}
		if (MULTI) {
			f = d "/manifest.tsv"
			while ((getline line < f) > 0) {
				n = split(line, x, "\t")
				if (n < 4 || x[2] == "" || x[4] == "") continue
				ND++; D_g[ND] = grp(x[1]); D_v[ND] = ver(x[1]); D_k[ND] = x[2]; D_ns[ND] = nv(x[3]); D_nm[ND] = x[4]
			}
			close(f)
		}
	}
	C_ns[c] = NSEG - C_s0[c]; C_nn[c] = NN - C_n0[c]; C_nu[c] = NU - C_u0[c]; C_nd[c] = ND - C_d0[c]
}

function jstr(s,   o, i, c) {
	if (!index(s, "\\") && !index(s, "\"") && s !~ CTRLRE) return "\"" s "\""
	o = ""
	for (i = 1; i <= length(s); i++) {
		c = substr(s, i, 1)
		if (c == "\\") o = o "\\\\"
		else if (c == "\"") o = o "\\\""
		else if (c in JCTRL) o = o JCTRL[c]
		else o = o c
	}
	return "\"" o "\""
}
function jopt(has, s) { return has ? jstr(s) : "null" }
# Inline Markdown/HTML: names may come from anywhere, so every character
# that Markdown or HTML could interpret becomes a numeric entity.
function md(s,   o, i, c) {
	o = ""
	for (i = 1; i <= length(s); i++) {
		c = substr(s, i, 1)
		if (index(MDSPECIAL, c)) o = o "&#" ORD[c] ";"
		else if (c in JCTRL) o = o " "
		else o = o c
	}
	return o
}
# kubectl diff masks Secret data but not the last-applied-configuration
# annotation, which holds the applied data as one JSON line. Reports get
# posted to pull requests, so that line is replaced (counts are kept).
function redactSecrets(   s, j, line, c, ws) {
	for (s = 1; s <= NSEG; s++) {
		if (!S_id[s] || S_hg[s] || S_k[s] != "Secret") continue
		for (j = 1; j <= S_n[s]; j++) {
			line = SL[s, j]
			c = substr(line, 1, 1)
			if (c != " " && c != "+" && c != "-") continue
			if (!index(line, "\"kind\":\"Secret\"") && !index(line, "\\\"kind\\\":\\\"Secret\\\"")) continue
			if (substr(line, 1, 4) == "--- " || substr(line, 1, 4) == "+++ ") continue
			match(substr(line, 2), /^[ ]*/)
			ws = substr(line, 2, RLENGTH)
			SL[s, j] = c ws REDACTED
		}
	}
}
function kindLabel(s) { return S_k[s] (S_g[s] != "" ? "." S_g[s] : "") }
function resName(s) { return S_id[s] ? kindLabel(s) "/" S_nm[s] : S_key[s] }
function resFull(s) {
	if (!S_id[s]) return S_key[s]
	return kindLabel(s) " " (S_ns[s] != "" ? S_ns[s] "/" : "") S_nm[s]
}
# Display body: the hunks, without the header lines naming temp files.
function bodyStart(s,   j) {
	for (j = 1; j <= S_n[s]; j++)
		if (substr(SL[s, j], 1, 3) == "@@ " || SL[s, j] ~ /^Binary files /) return j
	return S_n[s] + 1
}
function shown(s) {
	BODY_FROM = bodyStart(s)
	BODY_TOTAL = S_n[s] - BODY_FROM + 1
	BODY_TO = S_n[s]
	if (MAXL > 0 && BODY_TOTAL > MAXL) BODY_TO = BODY_FROM + MAXL - 1
}
function fence(s,   j, x, mx, f) {
	mx = 0
	for (j = BODY_FROM; j <= BODY_TO; j++) {
		x = SL[s, j]
		while (match(x, /`+/)) { if (RLENGTH > mx) mx = RLENGTH; x = substr(x, RSTART + RLENGTH) }
	}
	f = "```"
	while (length(f) <= mx) f = f "`"
	return f
}
function plural(n, w) { return n " " w (n == 1 ? "" : "s") }
function drifted(c) { return C_ns[c] + C_nu[c] }
function countsLine(c) {
	return CC[c, "create"] + 0 " create, " CC[c, "modify"] + 0 " modify, " CC[c, "delete"] + 0 " delete" \
		(CC[c, "unknown"] ? ", " CC[c, "unknown"] " unknown" : "") "; +" CADD[c] + 0 " -" CREM[c] + 0
}
function emit(t) { OUT = OUT t "\n" }
function fits(t) { return MAXB == 0 || length(OUT) + length(t) + RESERVE <= MAXB }
function uName(j) { return U_k[j] (U_g[j] != "" ? "." U_g[j] : "") "/" U_nm[j] }

# Text section for one resource: "=== PREFIXaction Kind ns/name (+a -r)" and
# its (possibly truncated) hunks.
function textSection(s, prefix,   t, j) {
	shown(s)
	t = "\n=== " prefix S_act[s] " " resFull(s) " (+" S_add[s] " -" S_rem[s] ")"
	for (j = BODY_FROM; j <= BODY_TO; j++) t = t "\n" SL[s, j]
	if (BODY_TO - BODY_FROM + 1 < BODY_TOTAL)
		t = t "\n... truncated: " (BODY_TO - BODY_FROM + 1) " of " BODY_TOTAL " lines shown (--max-diff-lines)"
	return t
}
function mdDetails(s, prefix,   t, f, j) {
	shown(s)
	f = fence(s)
	t = "\n<details>\n<summary>" prefix S_act[s] " " md(resFull(s)) " (+" S_add[s] " -" S_rem[s] ")</summary>\n\n" f "diff\n"
	for (j = BODY_FROM; j <= BODY_TO; j++) t = t SL[s, j] "\n"
	t = t f "\n"
	if (BODY_TO - BODY_FROM + 1 < BODY_TOTAL)
		t = t "\n_Truncated: " (BODY_TO - BODY_FROM + 1) " of " BODY_TOTAL " lines shown (--max-diff-lines)._\n"
	return t "\n</details>"
}
function mdNotes(c, prefix,   t, f, j, x) {
	t = "\n<details>\n<summary>" prefix plural(C_nn[c], "note") "</summary>\n\n"
	f = "```"
	for (j = C_n0[c] + 1; j <= C_n0[c] + C_nn[c]; j++) { x = NOTE[j]; while (match(x, /`+/)) { if (RLENGTH >= length(f)) f = f "`"; x = substr(x, RSTART + RLENGTH) } }
	t = t f "text\n"
	for (j = C_n0[c] + 1; j <= C_n0[c] + C_nn[c]; j++) t = t NOTE[j] "\n"
	return t f "\n\n</details>"
}

# One context in JSON, from "drift" through "notes" (the version 1 fields).
function jsonCtx(c,   s, s0, j, to, total) {
	s0 = C_s0[c]
	printf "\"drift\":%s,", drifted(c) ? "true" : "false"
	printf "\"summary\":{\"resources\":%d,\"create\":%d,\"modify\":%d,\"delete\":%d,\"unknown\":%d,\"added\":%d,\"removed\":%d,\"unmanaged\":%s},", \
		C_ns[c], CC[c, "create"], CC[c, "modify"], CC[c, "delete"], CC[c, "unknown"], CADD[c], CREM[c], UON ? C_nu[c] : "null"
	printf "\"resources\":["
	for (s = s0 + 1; s <= s0 + C_ns[c]; s++) {
		total = S_n[s]
		to = (MAXL > 0 && total > MAXL) ? MAXL : total
		printf "%s{\"key\":%s,\"group\":%s,\"version\":%s,\"kind\":%s,\"namespace\":%s,\"name\":%s,", \
			(s > s0 + 1 ? "," : ""), jstr(S_key[s]), jopt(S_id[s] && S_hg[s], S_g[s]), jopt(S_id[s], S_v[s]), \
			jopt(S_id[s], S_k[s]), jopt(S_id[s] && S_ns[s] != "", S_ns[s]), jopt(S_id[s], S_nm[s])
		printf "\"action\":%s,\"added\":%d,\"removed\":%d,\"binary\":%s,\"lineCount\":%d,\"truncated\":%s,\"lines\":[", \
			jstr(S_act[s]), S_add[s], S_rem[s], (S_bin[s] ? "true" : "false"), total, (to < total ? "true" : "false")
		for (j = 1; j <= to; j++) printf "%s%s", (j > 1 ? "," : ""), jstr(SL[s, j])
		printf "]}"
	}
	printf "],\"unmanaged\":"
	if (!UON) printf "null"
	else {
		printf "["
		for (j = C_u0[c] + 1; j <= C_u0[c] + C_nu[c]; j++)
			printf "%s{\"group\":%s,\"version\":%s,\"kind\":%s,\"namespace\":%s,\"name\":%s}", (j > C_u0[c] + 1 ? "," : ""), \
				jopt(U_g[j] != "", U_g[j]), jstr(U_v[j]), jstr(U_k[j]), jopt(U_ns[j] != "", U_ns[j]), jstr(U_nm[j])
		printf "]"
	}
	printf ",\"notes\":["
	for (j = C_n0[c] + 1; j <= C_n0[c] + C_nn[c]; j++) printf "%s%s", (j > C_n0[c] + 1 ? "," : ""), jstr(NOTE[j])
	printf "]"
}

function renderJSON() {
	printf "{\"version\":1,\"source\":{\"type\":%s,\"label\":%s},", jstr(ENVIRON["TKD_SOURCE_TYPE"]), jstr(LABEL)
	printf "\"context\":%s,\"namespace\":%s,", jopt(CTX != "", CTX), jopt(NSP != "", NSP)
	jsonCtx(1)
	printf "}\n"
}

function renderMarkdown(   s, j, t, rows, omitted) {
	RESERVE = 400
	t = "### Drift: " md(LABEL)
	emit(t)
	t = ""
	if (CTX != "") t = "Context " md(CTX)
	if (NSP != "") t = t (t != "" ? ", namespace " : "Namespace ") md(NSP)
	if (t != "") { emit(""); emit(t) }
	emit("")
	if (!drifted(1)) {
		emit("No drift: the cluster matches the manifests.")
	} else {
		t = "**" plural(C_ns[1], "resource") " drifted** (" countsLine(1) ")"
		if (UON) t = t ", **" C_nu[1] " unmanaged** in the cluster"
		emit(t ".")
	}
	if (C_ns[1]) {
		emit("")
		emit("| Change | Resource | Namespace | + | - |")
		emit("| --- | --- | --- | ---: | ---: |")
		rows = 0
		for (s = 1; s <= C_ns[1]; s++) {
			t = "| " S_act[s] " | " md(resName(s)) " | " md(S_ns[s]) " | " S_add[s] " | " S_rem[s] " |"
			if (!fits(t "\n")) break
			emit(t); rows++
		}
		if (rows < C_ns[1]) emit("| ... | " (C_ns[1] - rows) " more rows omitted (--max-bytes) | | | |")
		if (CC[1, "create"]) { emit(""); emit("_create: declared in the manifests, missing from the cluster._") }
		omitted = 0
		for (s = 1; s <= rows; s++) {
			t = mdDetails(s, "")
			if (!fits(t "\n")) { omitted++; continue }
			emit(t)
		}
		omitted += C_ns[1] - rows
		if (omitted) { emit(""); emit("_" plural(omitted, "diff") " omitted to stay under --max-bytes._") }
	}
	if (UON && C_nu[1]) {
		emit("")
		emit("#### Unmanaged in the cluster")
		emit("")
		emit("| Resource | Namespace |")
		emit("| --- | --- |")
		for (j = 1; j <= C_nu[1]; j++) {
			t = "| " md(uName(j)) " | " md(U_ns[j]) " |"
			if (!fits(t "\n")) { emit("| ... " (C_nu[1] - j + 1) " more omitted (--max-bytes) | |"); break }
			emit(t)
		}
	}
	if (C_nn[1]) {
		t = mdNotes(1, "")
		if (fits(t "\n")) emit(t)
		else emit("\n_" plural(C_nn[1], "note") " omitted (--max-bytes)._")
	}
	printf "%s", OUT
}

function pad(s, w) { while (length(s) < w) s = s " "; return s }
function renderText(   s, j, t, w1, w2, w3, omitted) {
	t = "Drift: " LABEL
	if (CTX != "") t = t " (context " CTX (NSP != "" ? ", namespace " NSP : "") ")"
	else if (NSP != "") t = t " (namespace " NSP ")"
	emit(t)
	if (C_ns[1]) {
		w1 = 6; w2 = 8; w3 = 9
		for (s = 1; s <= C_ns[1]; s++) {
			if (length(resName(s)) > w2) w2 = length(resName(s))
			if (length(S_ns[s]) > w3) w3 = length(S_ns[s])
		}
		emit("")
		emit(pad("CHANGE", w1) "  " pad("RESOURCE", w2) "  " pad("NAMESPACE", w3) "  +/-")
		for (s = 1; s <= C_ns[1]; s++)
			emit(pad(S_act[s], w1) "  " pad(resName(s), w2) "  " pad(S_ns[s] != "" ? S_ns[s] : "-", w3) "  +" S_add[s] " -" S_rem[s])
	}
	if (UON && C_nu[1]) {
		emit("")
		emit("Unmanaged in the cluster:")
		for (j = 1; j <= C_nu[1]; j++) emit("  " uName(j) (U_ns[j] != "" ? " (namespace " U_ns[j] ")" : ""))
	}
	emit("")
	if (!drifted(1)) emit("No drift.")
	else emit(plural(C_ns[1], "resource") " drifted (" countsLine(1) ")" (UON ? ", " C_nu[1] " unmanaged" : "") ".")
	if (C_nn[1]) {
		emit("")
		emit("Notes:")
		for (j = 1; j <= C_nn[1]; j++) emit("  " NOTE[j])
	}
	RESERVE = 100
	omitted = 0
	for (s = 1; s <= C_ns[1]; s++) {
		t = textSection(s, "")
		if (!fits(t "\n")) { omitted++; continue }
		emit(t)
	}
	if (omitted) emit("\n" plural(omitted, "diff") " omitted to stay under --max-bytes.")
	printf "%s", OUT
}

# --- Several contexts: one row per object over all contexts ----------------

function rowFor(id, key, g, v, k, ns, nm, ident,   r) {
	if (id in ROW) return ROW[id]
	r = ++NROW
	ROW[id] = r
	R_key[r] = key; R_g[r] = g; R_v[r] = v; R_k[r] = k; R_ns[r] = ns; R_nm[r] = nm; R_id[r] = ident
	return r
}
function objKey(g, v, k, ns, nm) { return (g != "" ? g "." : "") v "." k "." ns "." nm }
function setCell(r, c, state, a, d) {
	if ((r, c) in CELL) return
	CELL[r, c] = state; CA[r, c] = a; CR[r, c] = d
}
# Rows: diffed objects, then unmanaged, then declared ones the diff did not
# mention (in sync); sorted by namespace, kind and name.
function buildMatrix(   c, s, j, r, i, k, x) {
	NROW = 0
	for (c = 1; c <= N; c++) {
		if (!C_ok[c]) continue
		for (s = C_s0[c] + 1; s <= C_s0[c] + C_ns[c]; s++) {
			if (S_id[s]) r = rowFor(S_g[s] SUBSEP S_k[s] SUBSEP S_ns[s] SUBSEP S_nm[s], S_key[s], S_g[s], S_v[s], S_k[s], S_ns[s], S_nm[s], 1)
			else r = rowFor("?" SUBSEP S_key[s], S_key[s], "", "", "", "", "", 0)
			setCell(r, c, S_act[s], S_add[s], S_rem[s])
		}
		for (j = C_u0[c] + 1; j <= C_u0[c] + C_nu[c]; j++) {
			r = rowFor(U_g[j] SUBSEP U_k[j] SUBSEP U_ns[j] SUBSEP U_nm[j], objKey(U_g[j], U_v[j], U_k[j], U_ns[j], U_nm[j]), \
				U_g[j], U_v[j], U_k[j], U_ns[j], U_nm[j], 1)
			setCell(r, c, "unmanaged")
		}
		for (j = C_d0[c] + 1; j <= C_d0[c] + C_nd[c]; j++) {
			r = rowFor(D_g[j] SUBSEP D_k[j] SUBSEP D_ns[j] SUBSEP D_nm[j], objKey(D_g[j], D_v[j], D_k[j], D_ns[j], D_nm[j]), \
				D_g[j], D_v[j], D_k[j], D_ns[j], D_nm[j], 1)
			setCell(r, c, "insync")
		}
	}
	for (r = 1; r <= NROW; r++) {
		RK[r] = (R_id[r] ? "0" : "1") "\001" R_ns[r] "\001" rowKind(r) "\001" R_nm[r] "\001" R_key[r]
		ORDER[r] = r
	}
	for (i = 2; i <= NROW; i++) {
		x = ORDER[i]
		for (k = i - 1; k >= 1 && RK[ORDER[k]] > RK[x]; k--) ORDER[k + 1] = ORDER[k]
		ORDER[k + 1] = x
	}
}
function rowKind(r) { return R_k[r] (R_g[r] != "" ? "." R_g[r] : "") }
function rowName(r) { return R_id[r] ? rowKind(r) "/" R_nm[r] : R_key[r] }
function cellState(r, c) {
	if (!C_ok[c]) return "error"
	return ((r, c) in CELL) ? CELL[r, c] : "absent"
}
function cellText(r, c,   st) {
	st = cellState(r, c)
	if (st == "insync") return "in sync"
	if (st == "absent") return "-"
	if (st == "modify") return "modify +" CA[r, c] " -" CR[r, c]
	return st
}
function hasCounts(st) { return st == "create" || st == "modify" || st == "delete" || st == "unknown" }
function anyCreate(   r, c) {
	for (r = 1; r <= NROW; r++)
		for (c = 1; c <= N; c++)
			if (cellState(r, c) == "create") return 1
	return 0
}
function tally(   c) {
	NDRIFT = 0; NERR = 0
	for (c = 1; c <= N; c++) {
		if (!C_ok[c]) NERR++
		else if (drifted(c)) NDRIFT++
	}
}

function renderMultiJSON(   c, r, i, st) {
	printf "{\"version\":2,\"source\":{\"type\":%s,\"label\":%s},", jstr(ENVIRON["TKD_SOURCE_TYPE"]), jstr(LABEL)
	printf "\"namespace\":%s,\"drift\":%s,", jopt(NSP != "", NSP), NDRIFT ? "true" : "false"
	printf "\"summary\":{\"contexts\":%d,\"drifted\":%d,\"errors\":%d},\"contexts\":[", N, NDRIFT, NERR
	for (c = 1; c <= N; c++) {
		printf "%s{\"context\":%s,\"status\":%s,\"error\":%s,", (c > 1 ? "," : ""), jstr(C_name[c]), \
			jstr(C_ok[c] ? "ok" : "error"), jopt(!C_ok[c], C_err[c])
		if (C_ok[c]) jsonCtx(c)
		else printf "\"drift\":null,\"summary\":null,\"resources\":[],\"unmanaged\":null,\"notes\":[]"
		printf "}"
	}
	printf "],\"matrix\":["
	for (i = 1; i <= NROW; i++) {
		r = ORDER[i]
		printf "%s{\"key\":%s,\"group\":%s,\"version\":%s,\"kind\":%s,\"namespace\":%s,\"name\":%s,\"cells\":[", \
			(i > 1 ? "," : ""), jstr(R_key[r]), jopt(R_id[r] && R_g[r] != "", R_g[r]), jopt(R_id[r], R_v[r]), \
			jopt(R_id[r], R_k[r]), jopt(R_id[r] && R_ns[r] != "", R_ns[r]), jopt(R_id[r], R_nm[r])
		for (c = 1; c <= N; c++) {
			st = cellState(r, c)
			printf "%s{\"context\":%s,\"state\":%s,\"added\":%s,\"removed\":%s}", (c > 1 ? "," : ""), jstr(C_name[c]), \
				jstr(st), hasCounts(st) ? CA[r, c] + 0 : "null", hasCounts(st) ? CR[r, c] + 0 : "null"
		}
		printf "]}"
	}
	printf "]}\n"
}

function ctxResult(c, markdown) {
	if (!C_ok[c]) return markdown ? "**error**: " md(C_err[c]) : "error: " C_err[c]
	if (!drifted(c)) return markdown ? "no drift" : "no drift."
	if (markdown) return "**" plural(C_ns[c], "resource") " drifted** (" countsLine(c) ")" (UON ? ", " C_nu[c] " unmanaged" : "")
	return plural(C_ns[c], "resource") " drifted (" countsLine(c) ")" (UON ? ", " C_nu[c] " unmanaged" : "") "."
}

# --max-bytes: the matrix and the per-context results are always printed;
# whole diffs are then added in context order until one does not fit, so
# diffs are dropped from the last context backwards.
function renderMultiMarkdown(   c, r, i, s, t, hdr, sep, omitted, stop) {
	RESERVE = 400
	emit("### Drift: " md(LABEL) " across " N " contexts")
	if (NSP != "") { emit(""); emit("Namespace " md(NSP)) }
	emit("")
	if (!NDRIFT && !NERR) emit("No drift: every cluster matches the manifests.")
	else emit("**" NDRIFT " of " N " contexts drifted**" (NERR ? ", **" NERR " failed**" : "") ".")
	if (NROW) {
		hdr = "| Resource | Namespace |"; sep = "| --- | --- |"
		for (c = 1; c <= N; c++) { hdr = hdr " " md(C_name[c]) " |"; sep = sep " --- |" }
		emit("")
		emit(hdr)
		emit(sep)
		for (i = 1; i <= NROW; i++) {
			r = ORDER[i]
			t = "| " md(rowName(r)) " | " md(R_ns[r]) " |"
			for (c = 1; c <= N; c++) t = t " " cellText(r, c) " |"
			emit(t)
		}
		if (anyCreate()) { emit(""); emit("_create: declared in the manifests, missing from the cluster._") }
	}
	emit("")
	emit("| Context | Result |")
	emit("| --- | --- |")
	for (c = 1; c <= N; c++) emit("| " md(C_name[c]) " | " ctxResult(c, 1) " |")
	for (c = 1; c <= N; c++) {
		if (!C_ok[c] || !C_nn[c]) continue
		t = mdNotes(c, "[" md(C_name[c]) "] ")
		if (fits(t "\n")) emit(t)
		else emit("\n_[" md(C_name[c]) "] " plural(C_nn[c], "note") " omitted (--max-bytes)._")
	}
	omitted = 0; stop = 0
	for (c = 1; c <= N; c++) {
		if (!C_ok[c]) continue
		for (s = C_s0[c] + 1; s <= C_s0[c] + C_ns[c]; s++) {
			if (!stop) {
				t = mdDetails(s, "[" md(C_name[c]) "] ")
				if (fits(t "\n")) { emit(t); continue }
				stop = 1
			}
			omitted++
		}
	}
	if (omitted) { emit(""); emit("_" plural(omitted, "diff") " omitted to stay under --max-bytes._") }
	printf "%s", OUT
}

function renderMultiText(   c, r, i, s, t, w1, w2, w, omitted, stop, anyNotes, j) {
	t = "Drift: " LABEL " across " N " contexts"
	if (NSP != "") t = t " (namespace " NSP ")"
	emit(t)
	if (NROW) {
		w1 = 8; w2 = 9
		for (c = 1; c <= N; c++) w[c] = length(C_name[c])
		for (i = 1; i <= NROW; i++) {
			r = ORDER[i]
			if (length(rowName(r)) > w1) w1 = length(rowName(r))
			if (length(R_ns[r]) > w2) w2 = length(R_ns[r])
			for (c = 1; c <= N; c++) if (length(cellText(r, c)) > w[c]) w[c] = length(cellText(r, c))
		}
		emit("")
		t = pad("RESOURCE", w1) "  " pad("NAMESPACE", w2)
		for (c = 1; c <= N; c++) t = t "  " (c < N ? pad(C_name[c], w[c]) : C_name[c])
		emit(t)
		for (i = 1; i <= NROW; i++) {
			r = ORDER[i]
			t = pad(rowName(r), w1) "  " pad(R_ns[r] != "" ? R_ns[r] : "-", w2)
			for (c = 1; c <= N; c++) t = t "  " (c < N ? pad(cellText(r, c), w[c]) : cellText(r, c))
			emit(t)
		}
	}
	emit("")
	for (c = 1; c <= N; c++) emit(C_name[c] ": " ctxResult(c, 0))
	anyNotes = 0
	for (c = 1; c <= N; c++) if (C_ok[c] && C_nn[c]) anyNotes = 1
	if (anyNotes) {
		emit("")
		emit("Notes:")
		for (c = 1; c <= N; c++)
			if (C_ok[c])
				for (j = C_n0[c] + 1; j <= C_n0[c] + C_nn[c]; j++) emit("  [" C_name[c] "] " NOTE[j])
	}
	RESERVE = 100
	omitted = 0; stop = 0
	for (c = 1; c <= N; c++) {
		if (!C_ok[c]) continue
		for (s = C_s0[c] + 1; s <= C_s0[c] + C_ns[c]; s++) {
			if (!stop) {
				t = textSection(s, "[" C_name[c] "] ")
				if (fits(t "\n")) { emit(t); continue }
				stop = 1
			}
			omitted++
		}
	}
	if (omitted) emit("\n" plural(omitted, "diff") " omitted to stay under --max-bytes.")
	printf "%s", OUT
}

BEGIN {
	WSCH = " \t\r" sprintf("%c%c", 11, 12)
	WSDIFF = "^diff -[^" WSCH "]+ "
	WSEND = "[" WSCH "]$"
	LASTTOK = "[^" WSCH "]+$"
	CTRLRE = "[" sprintf("%c", 1) "-" sprintf("%c", 31) "]"
	for (i = 1; i < 32; i++) JCTRL[sprintf("%c", i)] = sprintf("\\u%04x", i)
	JCTRL["\t"] = "\\t"; JCTRL["\n"] = "\\n"; JCTRL["\r"] = "\\r"; JCTRL["\b"] = "\\b"; JCTRL["\f"] = "\\f"
	for (i = 32; i < 127; i++) ORD[sprintf("%c", i)] = i
	MDSPECIAL = "&<>\"'\''`|\\*_[]~@#!()$:{}"
	REDACTED = "*** (last-applied-configuration redacted by tern-kube-drift)"
	FMT = ENVIRON["TKD_FORMAT"]; MAXL = ENVIRON["TKD_MAX_LINES"] + 0; MAXB = ENVIRON["TKD_MAX_BYTES"] + 0
	LABEL = ENVIRON["TKD_LABEL"]; CTX = ENVIRON["TKD_CONTEXT"]; NSP = ENVIRON["TKD_NAMESPACE"]
	UON = ENVIRON["TKD_UNMANAGED_ON"] != ""
	DIR = ENVIRON["TKD_DIR"]; N = ENVIRON["TKD_N"] + 0; MULTI = ENVIRON["TKD_MULTI"] == "1"
	NL = 0; NSEG = 0; NN = 0; NU = 0; ND = 0; OUT = ""
}
END {
	for (c = 1; c <= N; c++) load(c)
	redactSecrets()
	if (!MULTI) {
		if (FMT == "json") renderJSON()
		else if (FMT == "markdown") renderMarkdown()
		else renderText()
		exit (drifted(1) ? 1 : 0)
	}
	buildMatrix()
	tally()
	if (FMT == "json") renderMultiJSON()
	else if (FMT == "markdown") renderMultiMarkdown()
	else renderMultiText()
	exit (NDRIFT ? 1 : 0)
}' /dev/null
report_rc=$?
case $report_rc in
0 | 1) ;;
*) die "report failed (awk exit $report_rc)" ;;
esac
[ "$errors" = 0 ] || exit 2
exit "$report_rc"
