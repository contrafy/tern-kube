#!/bin/sh
# kube-lens-drift: report drift between Kubernetes manifests and a cluster.
#
# Runs `kubectl diff` (server-side dry run, never mutates) for one source and
# reports per-resource changes as text, Markdown (PR comments, CI summaries)
# or JSON. Segmentation follows plugin/lib/mutation/diffseg.luau in
# github.com/contrafy/tern-kube-lens so the CLI and the Tern plugin agree.
#
# Requires only a POSIX shell, awk, sed, sort, mktemp and kubectl (helm for
# --helm). Exit status: 0 no drift, 1 drift, 2 error.

set -u
if [ -n "${ZSH_VERSION-}" ]; then emulate sh; fi

VERSION=0.1.0
prog=kube-lens-drift

usage() {
	cat <<'EOF'
usage: kube-lens-drift SOURCE [options]

SOURCE (exactly one):
  -f, --filename PATH        manifest file or directory (repeatable)
  -R, --recursive            with -f: recurse into directories
  -k, --kustomize DIR        kustomization directory
  --helm CHART --release R   render a chart with `helm template`; with --helm,
                             -f/--values FILE are values files (repeatable)

Options:
  --context C                kubeconfig context (default: current context)
  --kubeconfig K             kubeconfig file (default: kubectl's)
  -n, --namespace NS         namespace for objects without one
  --format text|markdown|json  output format (default text)
  --max-diff-lines N         show at most N diff lines per resource (0 = all)
  --max-bytes N              markdown/text: keep output under N bytes by
                             dropping whole per-resource diffs (0 = no limit)
  --unmanaged KINDS|auto     also list live objects of KINDS (comma-separated
                             kubectl resource names; `auto` = kinds in the
                             source) that no manifest declares, in the
                             namespaces the source covers
  -h, --help                 this help
  --version                  print the version

Environment: KUBECTL (default kubectl), HELM (default helm).
Exit status: 0 no drift, 1 drift, 2 error.
EOF
}

die() {
	printf '%s: %s\n' "$prog" "$*" >&2
	exit 2
}

# Single-quotes a word for later `eval "set -- ..."`.
q() {
	printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

need() {
	[ $# -ge 2 ] || die "$1 needs a value"
}

files=
nfiles=0
recursive=0
kdir=
chart=
release=
values=
context=
kubeconfig=
namespace=
format=text
max_lines=0
max_bytes=0
unmanaged=

while [ $# -gt 0 ]; do
	case $1 in
	-f | --filename)
		need "$@"
		files="$files $(q "$2")"
		nfiles=$((nfiles + 1))
		shift 2
		;;
	--filename=*)
		files="$files $(q "${1#*=}")"
		nfiles=$((nfiles + 1))
		shift
		;;
	--values)
		need "$@"
		values="$values $(q "$2")"
		shift 2
		;;
	--values=*)
		values="$values $(q "${1#*=}")"
		shift
		;;
	-R | --recursive)
		recursive=1
		shift
		;;
	-k | --kustomize)
		need "$@"
		[ -z "$kdir" ] || die "-k given twice"
		kdir=$2
		shift 2
		;;
	--kustomize=*)
		[ -z "$kdir" ] || die "-k given twice"
		kdir=${1#*=}
		shift
		;;
	--helm)
		need "$@"
		chart=$2
		shift 2
		;;
	--helm=*)
		chart=${1#*=}
		shift
		;;
	--release)
		need "$@"
		release=$2
		shift 2
		;;
	--release=*)
		release=${1#*=}
		shift
		;;
	--context)
		need "$@"
		context=$2
		shift 2
		;;
	--context=*)
		context=${1#*=}
		shift
		;;
	--kubeconfig)
		need "$@"
		kubeconfig=$2
		shift 2
		;;
	--kubeconfig=*)
		kubeconfig=${1#*=}
		shift
		;;
	-n | --namespace)
		need "$@"
		namespace=$2
		shift 2
		;;
	--namespace=*)
		namespace=${1#*=}
		shift
		;;
	--format)
		need "$@"
		format=$2
		shift 2
		;;
	--format=*)
		format=${1#*=}
		shift
		;;
	--max-diff-lines)
		need "$@"
		max_lines=$2
		shift 2
		;;
	--max-diff-lines=*)
		max_lines=${1#*=}
		shift
		;;
	--max-bytes)
		need "$@"
		max_bytes=$2
		shift 2
		;;
	--max-bytes=*)
		max_bytes=${1#*=}
		shift
		;;
	--unmanaged)
		need "$@"
		unmanaged=$2
		shift 2
		;;
	--unmanaged=*)
		unmanaged=${1#*=}
		shift
		;;
	-h | --help)
		usage
		exit 0
		;;
	--version)
		printf '%s %s\n' "$prog" "$VERSION"
		exit 0
		;;
	*)
		printf '%s: unknown argument: %s\n\n' "$prog" "$1" >&2
		usage >&2
		exit 2
		;;
	esac
done

case $format in
text | markdown | json) ;;
*) die "--format must be text, markdown or json" ;;
esac
case $max_lines in
'' | *[!0-9]*) die "--max-diff-lines must be a non-negative integer" ;;
esac
case $max_bytes in
'' | *[!0-9]*) die "--max-bytes must be a non-negative integer" ;;
esac
if [ -n "$chart" ]; then
	[ -z "$kdir" ] || die "--helm and -k are mutually exclusive"
	[ -n "$release" ] || die "--helm needs --release"
	[ "$recursive" = 0 ] || die "-R does not apply to --helm"
	values="$files$values"
	files=
	src_type=helm
	label="helm $chart (release $release)"
elif [ -n "$kdir" ]; then
	[ "$nfiles" = 0 ] || die "-f and -k are mutually exclusive"
	[ -z "$release$values" ] || die "--release/--values need --helm"
	[ "$recursive" = 0 ] || die "-R does not apply to -k"
	src_type=kustomize
	label=$kdir
else
	[ "$nfiles" -gt 0 ] || die "no source: give -f PATH, -k DIR or --helm CHART"
	[ -z "$release$values" ] || die "--release/--values need --helm"
	src_type=file
	eval "set -- $files"
	label=$*
fi

kubectl_bin=${KUBECTL:-kubectl}
helm_bin=${HELM:-helm}
command -v "$kubectl_bin" >/dev/null 2>&1 || die "kubectl not found (set KUBECTL)"

# kubectl diff must print its built-in `diff -u -N` output.
unset KUBECTL_EXTERNAL_DIFF

tmp=$(mktemp -d "${TMPDIR:-/tmp}/kube-lens-drift.XXXXXX") || die "cannot create a temp dir"
trap 'rm -rf "$tmp"' EXIT
trap 'exit 2' HUP INT TERM

kc() {
	"$kubectl_bin" ${kubeconfig:+--kubeconfig "$kubeconfig"} ${context:+--context "$context"} "$@"
}

if [ "$src_type" = helm ]; then
	command -v "$helm_bin" >/dev/null 2>&1 || die "helm not found (set HELM)"
	eval "set -- $values"
	for v in "$@"; do
		set -- "$@" -f "$v"
		shift
	done
	if ! "$helm_bin" template "$release" "$chart" ${namespace:+--namespace "$namespace"} "$@" \
		>"$tmp/rendered.yaml" 2>"$tmp/helm.err"; then
		cat "$tmp/helm.err" >&2
		die "helm template failed"
	fi
	files=" $(q "$tmp/rendered.yaml")"
fi

# Source flags for kubectl diff / apply --dry-run=client.
source_args() {
	if [ "$src_type" = kustomize ]; then
		set -- -k "$kdir"
	else
		eval "set -- $files"
		for f in "$@"; do
			set -- "$@" -f "$f"
			shift
		done
		[ "$recursive" = 0 ] || set -- "$@" -R
	fi
	for a in "$@"; do
		printf '%s ' "$(q "$a")"
	done
}
src=$(source_args)

ctx_name=$context
if [ -z "$ctx_name" ]; then
	ctx_name=$(kc config current-context 2>/dev/null) || ctx_name=
fi

eval "set -- $src"
kc diff ${namespace:+-n "$namespace"} "$@" >"$tmp/diff" 2>"$tmp/diff.err"
rc=$?
if [ -s "$tmp/diff.err" ]; then
	cat "$tmp/diff.err" >&2
fi
case $rc in
0 | 1) ;;
*) die "kubectl diff failed (exit $rc)" ;;
esac
if [ "$rc" = 1 ] && ! grep -Eq '^(@@ |Binary files )' "$tmp/diff"; then
	die "kubectl diff exited 1 without a diff"
fi

: >"$tmp/unmanaged.tsv"
if [ -n "$unmanaged" ]; then
	tpl='{{define "o"}}{{.apiVersion}}{{"\t"}}{{.kind}}{{"\t"}}{{.metadata.namespace}}{{"\t"}}{{.metadata.name}}{{"\n"}}{{end}}{{if eq .kind "List"}}{{range .items}}{{template "o" .}}{{end}}{{else}}{{template "o" .}}{{end}}'
	if ! kc apply --dry-run=client ${namespace:+-n "$namespace"} "$@" -o go-template="$tpl" \
		>"$tmp/manifest.tsv" 2>"$tmp/apply.err"; then
		cat "$tmp/apply.err" >&2
		die "cannot list the source's objects (kubectl apply --dry-run=client)"
	fi
	if [ "$unmanaged" = auto ]; then
		kinds=$(LC_ALL=C awk -F '\t' '
			{ g = $1; if (index(g, "/")) sub(/\/.*/, "", g); else g = ""
			  k = $2; if (g != "") k = k "." g
			  if (!(k in seen)) { seen[k] = 1; out = out (out == "" ? "" : ",") k } }
			END { print out }' "$tmp/manifest.tsv")
	else
		kinds=$unmanaged
	fi
	namespaces=$(LC_ALL=C awk -F '\t' '$3 != "" && $3 != "<no value>" { print $3 }' "$tmp/manifest.tsv" | LC_ALL=C sort -u)
	if [ -n "$namespace" ]; then
		namespaces=$(printf '%s\n%s\n' "$namespaces" "$namespace" | LC_ALL=C sort -u)
	fi
	ltpl='{{range .items}}{{.apiVersion}}{{"\t"}}{{.kind}}{{"\t"}}{{.metadata.namespace}}{{"\t"}}{{.metadata.name}}{{"\t"}}{{if .metadata.ownerReferences}}owned{{else}}-{{end}}{{"\t"}}{{if .type}}{{.type}}{{else}}-{{end}}{{"\t"}}{{with .metadata.labels}}{{index . "kubernetes.io/bootstrapping"}}{{end}}{{"\n"}}{{end}}'
	: >"$tmp/live.tsv"
	old_ifs=$IFS
	set -f
	IFS=,
	for kind in $kinds; do
		IFS=$old_ifs
		[ -n "$kind" ] || continue
		if [ -n "$namespaces" ]; then
			for ns in $namespaces; do
				kc get "$kind" -n "$ns" -o go-template="$ltpl" >>"$tmp/live.tsv" 2>"$tmp/get.err" ||
					{ cat "$tmp/get.err" >&2; die "cannot list $kind in namespace $ns"; }
			done
		else
			kc get "$kind" -o go-template="$ltpl" >>"$tmp/live.tsv" 2>"$tmp/get.err" ||
				{ cat "$tmp/get.err" >&2; die "cannot list $kind"; }
		fi
	done
	IFS=$old_ifs
	set +f
	printf '%s\n' "$namespaces" >"$tmp/namespaces"
	LC_ALL=C awk -F '\t' -v OFS='\t' '
		function nv(s) { return s == "<no value>" ? "" : s }
		function grp(av) { return index(av, "/") ? substr(av, 1, index(av, "/") - 1) : "" }
		function ver(av) { return index(av, "/") ? substr(av, index(av, "/") + 1) : av }
		FILENAME == ARGV[1] { if ($0 != "") cover[$0] = 1; next }
		FILENAME == ARGV[2] { declared[grp($1) SUBSEP $2 SUBSEP nv($3) SUBSEP $4] = 1; next }
		{
			ns = nv($3); kind = $2; name = $4
			if (ns != "" && !(ns in cover)) next
			if ($5 == "owned") next
			if (kind == "Event" || kind == "Endpoints" || kind == "EndpointSlice" || kind == "Lease") next
			if (kind == "ServiceAccount" && name == "default") next
			if (kind == "ConfigMap" && name == "kube-root-ca.crt") next
			if (kind == "Secret" && ($6 == "helm.sh/release.v1" || $6 == "kubernetes.io/service-account-token")) next
			if (kind == "Namespace" && (name == "default" || name ~ /^kube-/)) next
			if (nv($7) != "" || name ~ /^system:/) next
			id = grp($1) SUBSEP kind SUBSEP ns SUBSEP name
			if (id in declared || id in seen) next
			seen[id] = 1
			print grp($1), ver($1), kind, ns, name
		}' "$tmp/namespaces" "$tmp/manifest.tsv" "$tmp/live.tsv" |
		LC_ALL=C sort -t "$(printf '\t')" -k3,3 -k4,4 -k5,5 >"$tmp/unmanaged.tsv"
fi

KLD_FORMAT=$format KLD_MAX_LINES=$max_lines KLD_MAX_BYTES=$max_bytes KLD_LABEL=$label \
	KLD_SOURCE_TYPE=$src_type KLD_CONTEXT=$ctx_name KLD_NAMESPACE=$namespace \
	KLD_UNMANAGED=$tmp/unmanaged.tsv KLD_UNMANAGED_ON=${unmanaged:+1} \
	LC_ALL=C awk '
# Port of plugin/lib/mutation/diffseg.luau M.parse; keep the two in step
# (tests/shell/drift checks them against the same golden inputs).
function basename(p) {
	if (match(p, /[^\/]+$/)) return substr(p, RSTART)
	return p
}
function headerPath(line,   b, t) {
	b = substr(line, 5)
	t = index(b, "\t")
	return t ? substr(b, 1, t - 1) : b
}
function isVersion(t) {
	return t ~ /^v[0-9]+$/ || t ~ /^v[0-9]+[a-z]+[0-9]+$/
}
function identity(f,   p, np, i, j, nm, g) {
	np = split(f, p, "[.]")
	for (i = 1; i <= np - 3; i++) {
		if (isVersion(p[i]) && p[i + 1] ~ /^[A-Z]/) {
			nm = p[i + 3]
			for (j = i + 4; j <= np; j++) nm = nm "." p[j]
			if (nm == "") return 0
			g = ""
			if (i > 1) { g = p[1]; for (j = 2; j < i; j++) g = g "." p[j] }
			ID_hg = (i > 1); ID_g = g; ID_v = p[i]; ID_k = p[i + 1]; ID_ns = p[i + 2]; ID_nm = nm
			return 1
		}
	}
	return 0
}
function setKey(s, key) {
	S_key[s] = key
	S_id[s] = identity(key)
	if (S_id[s]) {
		S_hg[s] = ID_hg; S_g[s] = ID_g; S_v[s] = ID_v; S_k[s] = ID_k; S_ns[s] = ID_ns; S_nm[s] = ID_nm
	}
}
function push(s, line) { S_n[s]++; SL[s, S_n[s]] = line }
function note(t) { NN++; NOTE[NN] = t }
function diffLineKey(line,   rest, ok) {
	ok = 0
	if (line ~ /^diff -u -N ./) { rest = substr(line, 12); ok = 1 }
	else if (match(line, WSDIFF) && RLENGTH < length(line)) { rest = substr(line, RLENGTH + 1); ok = 1 }
	if (!ok || rest ~ WSEND) return ""
	match(rest, LASTTOK)
	return basename(substr(rest, RSTART))
}
function hunkHeader(line,   r, m) {
	if (!match(line, /^@@ -[0-9]+,?[0-9]* \+[0-9]+,?[0-9]* @@/)) return 0
	r = substr(line, 5)
	match(r, /^[0-9]+/); r = substr(r, RLENGTH + 1)
	if (substr(r, 1, 1) == ",") r = substr(r, 2)
	match(r, /^[0-9]*/); m = substr(r, 1, RLENGTH); r = substr(r, RLENGTH + 1)
	HH_old = (m == "") ? 1 : m + 0
	r = substr(r, 3)
	match(r, /^[0-9]+/); r = substr(r, RLENGTH + 1)
	if (substr(r, 1, 1) == ",") r = substr(r, 2)
	match(r, /^[0-9]*/); m = substr(r, 1, RLENGTH)
	HH_new = (m == "") ? 1 : m + 0
	return 1
}
function start(key, first) {
	finish()
	cur = ++NSEG
	setKey(cur, key)
	S_act[cur] = "unknown"; S_add[cur] = 0; S_rem[cur] = 0; S_bin[cur] = 0; S_n[cur] = 0
	push(cur, first)
	oE = 0; nE = 0; oS = 0; nS = 0
}
function finish(   s, a) {
	if (!cur) return
	s = cur
	if (hk && (oL > 0 || nL > 0)) note(S_key[s] ": hunk ended early")
	if (S_bin[s]) S_act[s] = "unknown"
	else if (oE && !oS && nS) S_act[s] = "create"
	else if (nE && !nS && oS) S_act[s] = "delete"
	else if (oS || nS) S_act[s] = "modify"
	a = S_act[s]
	CNT[a]++
	TADD += S_add[s]; TREM += S_rem[s]
	cur = 0; hk = 0
}
function parse(   i, line, c, key, merged) {
	cur = 0; hk = 0; i = 1
	while (i <= NL) {
		line = L[i]
		if (hk && (oL > 0 || nL > 0)) {
			c = substr(line, 1, 1)
			if (c == " " || line == "") { oL--; nL-- }
			else if (c == "-") { oL--; S_rem[cur]++ }
			else if (c == "+") { nL--; S_add[cur]++ }
			else if (c != "\\") { note(S_key[cur] ": hunk ended early"); hk = 0; continue }
			push(cur, line); i++; continue
		}
		key = diffLineKey(line)
		if (key != "") {
			start(key, line)
		} else if (substr(line, 1, 4) == "--- " && substr(L[i + 1], 1, 4) == "+++ ") {
			merged = basename(headerPath(L[i + 1]))
			if (!cur || S_n[cur] > 1) start(merged, line)
			else {
				push(cur, line)
				if (!S_id[cur]) setKey(cur, merged)
			}
			push(cur, L[i + 1])
			i += 2; continue
		} else if (cur && substr(line, 1, 3) == "@@ ") {
			if (!hunkHeader(line)) {
				note(S_key[cur] ": unreadable hunk header " line)
				push(cur, line); i++; continue
			}
			if (HH_old == 0) oE = 1; else oS = 1
			if (HH_new == 0) nE = 1; else nS = 1
			hk = 1; oL = HH_old; nL = HH_new
			push(cur, line)
		} else if (cur && line ~ /^Binary files .+ differ$/) {
			S_bin[cur] = 1
			push(cur, line)
		} else if (line != "") {
			note(line)
		}
		i++
	}
	finish()
}

function jstr(s,   o, i, c) {
	if (!index(s, "\\") && !index(s, "\"") && s !~ CTRLRE) return "\"" s "\""
	o = ""
	for (i = 1; i <= length(s); i++) {
		c = substr(s, i, 1)
		if (c == "\\") o = o "\\\\"
		else if (c == "\"") o = o "\\\""
		else if (c in JCTRL) o = o JCTRL[c]
		else o = o c
	}
	return "\"" o "\""
}
function jopt(has, s) { return has ? jstr(s) : "null" }
# Inline Markdown/HTML: names may come from anywhere, so every character
# that Markdown or HTML could interpret becomes a numeric entity.
function md(s,   o, i, c) {
	o = ""
	for (i = 1; i <= length(s); i++) {
		c = substr(s, i, 1)
		if (index(MDSPECIAL, c)) o = o "&#" ORD[c] ";"
		else if (c in JCTRL) o = o " "
		else o = o c
	}
	return o
}
# kubectl diff masks Secret data but not the last-applied-configuration
# annotation, which holds the applied data as one JSON line. Reports get
# posted to pull requests, so that line is replaced (counts are kept).
function redactSecrets(   s, j, line, c, ws) {
	for (s = 1; s <= NSEG; s++) {
		if (!S_id[s] || S_hg[s] || S_k[s] != "Secret") continue
		for (j = 1; j <= S_n[s]; j++) {
			line = SL[s, j]
			c = substr(line, 1, 1)
			if (c != " " && c != "+" && c != "-") continue
			if (!index(line, "\"kind\":\"Secret\"") && !index(line, "\\\"kind\\\":\\\"Secret\\\"")) continue
			if (substr(line, 1, 4) == "--- " || substr(line, 1, 4) == "+++ ") continue
			match(substr(line, 2), /^[ ]*/)
			ws = substr(line, 2, RLENGTH)
			SL[s, j] = c ws REDACTED
		}
	}
}
function kindLabel(s) { return S_k[s] (S_g[s] != "" ? "." S_g[s] : "") }
function resName(s) { return S_id[s] ? kindLabel(s) "/" S_nm[s] : S_key[s] }
function resFull(s) {
	if (!S_id[s]) return S_key[s]
	return kindLabel(s) " " (S_ns[s] != "" ? S_ns[s] "/" : "") S_nm[s]
}
# Display body: the hunks, without the header lines naming temp files.
function bodyStart(s,   j) {
	for (j = 1; j <= S_n[s]; j++)
		if (substr(SL[s, j], 1, 3) == "@@ " || SL[s, j] ~ /^Binary files /) return j
	return S_n[s] + 1
}
function shown(s) {
	BODY_FROM = bodyStart(s)
	BODY_TOTAL = S_n[s] - BODY_FROM + 1
	BODY_TO = S_n[s]
	if (MAXL > 0 && BODY_TOTAL > MAXL) BODY_TO = BODY_FROM + MAXL - 1
}
function fence(s,   j, x, mx, f) {
	mx = 0
	for (j = BODY_FROM; j <= BODY_TO; j++) {
		x = SL[s, j]
		while (match(x, /`+/)) { if (RLENGTH > mx) mx = RLENGTH; x = substr(x, RSTART + RLENGTH) }
	}
	f = "```"
	while (length(f) <= mx) f = f "`"
	return f
}
function plural(n, w) { return n " " w (n == 1 ? "" : "s") }
function drifted() { return NSEG + NU }
function countsLine() {
	return CNT["create"] + 0 " create, " CNT["modify"] + 0 " modify, " CNT["delete"] + 0 " delete" \
		(CNT["unknown"] ? ", " CNT["unknown"] " unknown" : "") "; +" TADD + 0 " -" TREM + 0
}
function emit(t) { OUT = OUT t "\n" }
function fits(t) { return MAXB == 0 || length(OUT) + length(t) + RESERVE <= MAXB }

function renderJSON(   s, j, to, total) {
	printf "{\"version\":1,\"source\":{\"type\":%s,\"label\":%s},", jstr(ENVIRON["KLD_SOURCE_TYPE"]), jstr(LABEL)
	printf "\"context\":%s,\"namespace\":%s,", jopt(CTX != "", CTX), jopt(NSP != "", NSP)
	printf "\"drift\":%s,", drifted() ? "true" : "false"
	printf "\"summary\":{\"resources\":%d,\"create\":%d,\"modify\":%d,\"delete\":%d,\"unknown\":%d,\"added\":%d,\"removed\":%d,\"unmanaged\":%s},", \
		NSEG, CNT["create"], CNT["modify"], CNT["delete"], CNT["unknown"], TADD, TREM, UON ? NU : "null"
	printf "\"resources\":["
	for (s = 1; s <= NSEG; s++) {
		total = S_n[s]
		to = (MAXL > 0 && total > MAXL) ? MAXL : total
		printf "%s{\"key\":%s,\"group\":%s,\"version\":%s,\"kind\":%s,\"namespace\":%s,\"name\":%s,", \
			(s > 1 ? "," : ""), jstr(S_key[s]), jopt(S_id[s] && S_hg[s], S_g[s]), jopt(S_id[s], S_v[s]), \
			jopt(S_id[s], S_k[s]), jopt(S_id[s] && S_ns[s] != "", S_ns[s]), jopt(S_id[s], S_nm[s])
		printf "\"action\":%s,\"added\":%d,\"removed\":%d,\"binary\":%s,\"lineCount\":%d,\"truncated\":%s,\"lines\":[", \
			jstr(S_act[s]), S_add[s], S_rem[s], (S_bin[s] ? "true" : "false"), total, (to < total ? "true" : "false")
		for (j = 1; j <= to; j++) printf "%s%s", (j > 1 ? "," : ""), jstr(SL[s, j])
		printf "]}"
	}
	printf "],\"unmanaged\":"
	if (!UON) printf "null"
	else {
		printf "["
		for (j = 1; j <= NU; j++)
			printf "%s{\"group\":%s,\"version\":%s,\"kind\":%s,\"namespace\":%s,\"name\":%s}", (j > 1 ? "," : ""), \
				jopt(U_g[j] != "", U_g[j]), jstr(U_v[j]), jstr(U_k[j]), jopt(U_ns[j] != "", U_ns[j]), jstr(U_nm[j])
		printf "]"
	}
	printf ",\"notes\":["
	for (j = 1; j <= NN; j++) printf "%s%s", (j > 1 ? "," : ""), jstr(NOTE[j])
	printf "]}\n"
}

function uName(j) { return U_k[j] (U_g[j] != "" ? "." U_g[j] : "") "/" U_nm[j] }

function renderMarkdown(   s, j, t, f, x, rows, omitted) {
	RESERVE = 400
	t = "### Drift: " md(LABEL)
	emit(t)
	t = ""
	if (CTX != "") t = "Context " md(CTX)
	if (NSP != "") t = t (t != "" ? ", namespace " : "Namespace ") md(NSP)
	if (t != "") { emit(""); emit(t) }
	emit("")
	if (!drifted()) {
		emit("No drift: the cluster matches the manifests.")
	} else {
		t = "**" plural(NSEG, "resource") " drifted** (" countsLine() ")"
		if (UON) t = t ", **" NU " unmanaged** in the cluster"
		emit(t ".")
	}
	if (NSEG) {
		emit("")
		emit("| Change | Resource | Namespace | + | - |")
		emit("| --- | --- | --- | ---: | ---: |")
		rows = 0
		for (s = 1; s <= NSEG; s++) {
			t = "| " S_act[s] " | " md(resName(s)) " | " md(S_ns[s]) " | " S_add[s] " | " S_rem[s] " |"
			if (!fits(t "\n")) break
			emit(t); rows++
		}
		if (rows < NSEG) emit("| ... | " (NSEG - rows) " more rows omitted (--max-bytes) | | | |")
		if (CNT["create"]) { emit(""); emit("_create: declared in the manifests, missing from the cluster._") }
		omitted = 0
		for (s = 1; s <= rows; s++) {
			shown(s)
			f = fence(s)
			t = "\n<details>\n<summary>" S_act[s] " " md(resFull(s)) " (+" S_add[s] " -" S_rem[s] ")</summary>\n\n" f "diff\n"
			for (j = BODY_FROM; j <= BODY_TO; j++) t = t SL[s, j] "\n"
			t = t f "\n"
			if (BODY_TO - BODY_FROM + 1 < BODY_TOTAL)
				t = t "\n_Truncated: " (BODY_TO - BODY_FROM + 1) " of " BODY_TOTAL " lines shown (--max-diff-lines)._\n"
			t = t "\n</details>"
			if (!fits(t "\n")) { omitted++; continue }
			emit(t)
		}
		omitted += NSEG - rows
		if (omitted) { emit(""); emit("_" plural(omitted, "diff") " omitted to stay under --max-bytes._") }
	}
	if (UON && NU) {
		emit("")
		emit("#### Unmanaged in the cluster")
		emit("")
		emit("| Resource | Namespace |")
		emit("| --- | --- |")
		for (j = 1; j <= NU; j++) {
			t = "| " md(uName(j)) " | " md(U_ns[j]) " |"
			if (!fits(t "\n")) { emit("| ... " (NU - j + 1) " more omitted (--max-bytes) | |"); break }
			emit(t)
		}
	}
	if (NN) {
		t = "\n<details>\n<summary>" plural(NN, "note") "</summary>\n\n"
		f = "```"
		for (j = 1; j <= NN; j++) { x = NOTE[j]; while (match(x, /`+/)) { if (RLENGTH >= length(f)) f = f "`"; x = substr(x, RSTART + RLENGTH) } }
		t = t f "text\n"
		for (j = 1; j <= NN; j++) t = t NOTE[j] "\n"
		t = t f "\n\n</details>"
		if (fits(t "\n")) emit(t)
		else emit("\n_" plural(NN, "note") " omitted (--max-bytes)._")
	}
	printf "%s", OUT
}

function pad(s, w) { while (length(s) < w) s = s " "; return s }
function renderText(   s, j, t, w1, w2, w3, omitted) {
	t = "Drift: " LABEL
	if (CTX != "") t = t " (context " CTX (NSP != "" ? ", namespace " NSP : "") ")"
	else if (NSP != "") t = t " (namespace " NSP ")"
	emit(t)
	if (NSEG) {
		w1 = 6; w2 = 8; w3 = 9
		for (s = 1; s <= NSEG; s++) {
			if (length(resName(s)) > w2) w2 = length(resName(s))
			if (length(S_ns[s]) > w3) w3 = length(S_ns[s])
		}
		emit("")
		emit(pad("CHANGE", w1) "  " pad("RESOURCE", w2) "  " pad("NAMESPACE", w3) "  +/-")
		for (s = 1; s <= NSEG; s++)
			emit(pad(S_act[s], w1) "  " pad(resName(s), w2) "  " pad(S_ns[s] != "" ? S_ns[s] : "-", w3) "  +" S_add[s] " -" S_rem[s])
	}
	if (UON && NU) {
		emit("")
		emit("Unmanaged in the cluster:")
		for (j = 1; j <= NU; j++) emit("  " uName(j) (U_ns[j] != "" ? " (namespace " U_ns[j] ")" : ""))
	}
	emit("")
	if (!drifted()) emit("No drift.")
	else emit(plural(NSEG, "resource") " drifted (" countsLine() ")" (UON ? ", " NU " unmanaged" : "") ".")
	if (NN) {
		emit("")
		emit("Notes:")
		for (j = 1; j <= NN; j++) emit("  " NOTE[j])
	}
	RESERVE = 100
	omitted = 0
	for (s = 1; s <= NSEG; s++) {
		shown(s)
		t = "\n=== " S_act[s] " " resFull(s) " (+" S_add[s] " -" S_rem[s] ")"
		for (j = BODY_FROM; j <= BODY_TO; j++) t = t "\n" SL[s, j]
		if (BODY_TO - BODY_FROM + 1 < BODY_TOTAL)
			t = t "\n... truncated: " (BODY_TO - BODY_FROM + 1) " of " BODY_TOTAL " lines shown (--max-diff-lines)"
		if (!fits(t "\n")) { omitted++; continue }
		emit(t)
	}
	if (omitted) emit("\n" plural(omitted, "diff") " omitted to stay under --max-bytes.")
	printf "%s", OUT
}

BEGIN {
	WSCH = " \t\r" sprintf("%c%c", 11, 12)
	WSDIFF = "^diff -[^" WSCH "]+ "
	WSEND = "[" WSCH "]$"
	LASTTOK = "[^" WSCH "]+$"
	CTRLRE = "[" sprintf("%c", 1) "-" sprintf("%c", 31) "]"
	for (i = 1; i < 32; i++) JCTRL[sprintf("%c", i)] = sprintf("\\u%04x", i)
	JCTRL["\t"] = "\\t"; JCTRL["\n"] = "\\n"; JCTRL["\r"] = "\\r"; JCTRL["\b"] = "\\b"; JCTRL["\f"] = "\\f"
	for (i = 32; i < 127; i++) ORD[sprintf("%c", i)] = i
	MDSPECIAL = "&<>\"'\''`|\\*_[]~@#!()$:{}"
	REDACTED = "*** (last-applied-configuration redacted by kube-lens-drift)"
	FMT = ENVIRON["KLD_FORMAT"]; MAXL = ENVIRON["KLD_MAX_LINES"] + 0; MAXB = ENVIRON["KLD_MAX_BYTES"] + 0
	LABEL = ENVIRON["KLD_LABEL"]; CTX = ENVIRON["KLD_CONTEXT"]; NSP = ENVIRON["KLD_NAMESPACE"]
	UON = ENVIRON["KLD_UNMANAGED_ON"] != ""
	NL = 0; NSEG = 0; NN = 0; NU = 0; OUT = ""
}
{ sub(/\r$/, ""); L[++NL] = $0 }
END {
	parse()
	redactSecrets()
	if (UON) {
		uf = ENVIRON["KLD_UNMANAGED"]
		while ((getline line < uf) > 0) {
			n = split(line, f, "\t")
			if (n < 5) continue
			NU++; U_g[NU] = f[1]; U_v[NU] = f[2]; U_k[NU] = f[3]; U_ns[NU] = f[4]; U_nm[NU] = f[5]
		}
		close(uf)
	}
	if (FMT == "json") renderJSON()
	else if (FMT == "markdown") renderMarkdown()
	else renderText()
	exit (drifted() ? 1 : 0)
}' "$tmp/diff"
report_rc=$?
case $report_rc in
0 | 1) exit "$report_rc" ;;
*) die "report failed (awk exit $report_rc)" ;;
esac
