#!/bin/sh
# Fake kubectl for tests/shell/drift. Appends its argv (one `[arg]` per word)
# to $FAKE_DIR/argv and replays canned output from $FAKE_DIR:
#   context            `config current-context` (absent: exit 1)
#   contexts           `config get-contexts -o name` (absent: exit 1)
#   diff, diff.exit, diff.err   `diff` stdout, exit status, stderr; the Nth
#                      `diff` call replays diff.N, diff.N.exit, diff.N.err
#                      instead when diff.N exists
#   manifest.tsv       `create --dry-run=client -o go-template=...` output
#   source.yaml        `create --dry-run=client -o yaml` output
#   get/KIND.NS        `get KIND -n NS -o go-template=...` (NS `_` without -n)
# `diff -f DIR/rendered.yaml` and `diff -f DIR/present.yaml` keep a copy of
# the file in rendered.seen / present.seen.N (N: the diff call's number).
# When $FAKE_DIR/ctx exists, `--context C` replays $FAKE_DIR/ctx/C/ instead
# (same file names) and an unknown C fails like kubectl does.
# Any verb that could mutate exits 99 and leaves a MUTATION line in argv.
d=${FAKE_DIR:?FAKE_DIR not set}
{
	printf 'kubectl'
	for a in "$@"; do
		printf ' [%s]' "$a"
	done
	printf '\n'
	if [ -n "${KUBECTL_EXTERNAL_DIFF+set}" ]; then
		printf 'LEAK KUBECTL_EXTERNAL_DIFF=%s\n' "$KUBECTL_EXTERNAL_DIFF"
	fi
} >>"$d/argv"

ctx=
while [ $# -gt 0 ]; do
	case $1 in
	--kubeconfig) shift 2 ;;
	--context)
		ctx=$2
		shift 2
		;;
	*) break ;;
	esac
done

if [ "${1:-}" = config ] && [ "${2:-}" = get-contexts ]; then
	[ -f "$d/contexts" ] || exit 1
	cat "$d/contexts"
	exit 0
fi
if [ -n "$ctx" ] && [ -d "$d/ctx" ]; then
	[ -d "$d/ctx/$ctx" ] || {
		echo "error: context \"$ctx\" does not exist" >&2
		exit 1
	}
	d=$d/ctx/$ctx
fi

case ${1:-} in
config)
	[ "${2:-}" = current-context ] && [ -f "$d/context" ] || exit 1
	cat "$d/context"
	;;
diff)
	n=$(($(cat "$d/diff.count" 2>/dev/null || echo 0) + 1))
	echo "$n" >"$d/diff.count"
	for a in "$@"; do
		case $a in
		*/rendered.yaml) cp "$a" "$d/rendered.seen" ;;
		*/present.yaml) cp "$a" "$d/present.seen.$n" ;;
		esac
	done
	f=$d/diff
	[ -f "$d/diff.$n" ] && f=$d/diff.$n
	[ -f "$f.err" ] && cat "$f.err" >&2
	[ -f "$f" ] && cat "$f"
	exit "$(cat "$f.exit" 2>/dev/null || echo 0)"
	;;
create)
	dry=0
	out=$d/manifest.tsv
	prev=
	for a in "$@"; do
		[ "$a" = --dry-run=client ] && dry=1
		[ "$prev" = -o ] && [ "$a" = yaml ] && out=$d/source.yaml
		prev=$a
	done
	[ "$dry" = 1 ] || {
		echo "MUTATION create without --dry-run=client" >>"$d/argv"
		exit 99
	}
	[ -f "$out" ] && cat "$out"
	exit 0
	;;
get)
	kind=$2
	ns=_
	shift 2
	while [ $# -gt 0 ]; do
		case $1 in
		-n)
			ns=$2
			shift
			;;
		esac
		shift
	done
	f=$d/get/$kind.$ns
	[ -f "$f" ] || {
		echo "error: the server doesn't have a resource type \"$kind\"" >&2
		exit 1
	}
	cat "$f"
	;;
*)
	echo "MUTATION or unexpected verb: $*" >>"$d/argv"
	exit 99
	;;
esac
